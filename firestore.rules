rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    /*
     * Une formation est gratuite si son prix effectif est nul — le prix promotionnel prime
     * sur le prix public, exactement comme `Checkout.tsx` le calcule. Un document sans
     * `promoPrice` retombe sur `price`.
     */
    function isFreeFormation(formationId) {
      let f = get(/databases/$(database)/documents/formations/$(formationId)).data;
      return f.status == 'published' &&
        // ─────────────────────────────────────────────────────────────────────────────
        // UNE FORMATION EN COMING SOON N'EST PAS AUTO-INSCRIPTIBLE, MEME GRATUITE.
        //
        // « Coming Soon » est un drapeau posé sur une formation PUBLIEE : sans cette ligne,
        // une formation a venir dont le prix est nul (ou dont `promoPrice` vaut 0) tombait
        // dans la branche gratuite et n'importe quel compte connecte pouvait s'y inscrire.
        // Il aurait alors atterri dans un lecteur sans une seule lecon a ouvrir.
        //
        // `get('comingSoon', false)` et non `'comingSoon' in f` : le champ est absent de
        // toutes les formations anterieures, et son absence doit valoir « ouverte ».
        // ─────────────────────────────────────────────────────────────────────────────
        f.get('comingSoon', false) == false &&
        (('promoPrice' in f && f.promoPrice != null) ? f.promoPrice : f.price) == 0;
    }

    function isAdminOrSupport() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'support'];
    }

    function isEnrolled(formationId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + formationId));
    }

    /*
     * `likes` et `reposts` sont des TABLEAUX d'identifiants, pas des compteurs
     * (`arrayUnion(userId)` / `arrayRemove(userId)` cote client). Un membre autorise a
     * « mettre a jour le champ likes » pouvait donc en poster une version entiere :
     * vider les likes d'un post genant, ou s'en attribuer mille en y listant des UID.
     *
     * Ce predicat n'autorise qu'une bascule, et seulement pour soi : le tableau
     * d'arrivee est celui de depart plus ou moins le SEUL identifiant de l'appelant.
     */
    function togglesOwnMark(field) {
      let before = resource.data.get(field, []);
      let after = request.resource.data.get(field, []);
      return (
        // Ajout de son propre identifiant, rien d'autre ne bouge
        (after.size() == before.size() + 1 &&
         after.hasAll(before) &&
         request.auth.uid in after &&
         !(request.auth.uid in before))
        ||
        // Retrait de son propre identifiant, rien d'autre ne bouge
        (after.size() == before.size() - 1 &&
         before.hasAll(after) &&
         !(request.auth.uid in after) &&
         request.auth.uid in before)
      );
    }

    function hasActiveClubSub() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/club_subscriptions/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/club_subscriptions/$(request.auth.uid)).data.status == 'active';
    }

    // Users collection
    match /users/{userId} {
      // Users can read their own profile; admins can read all
      allow read: if isOwner(userId) || isAdmin();

      // ─────────────────────────────────────────────────────────────────────────────
      // LA CREATION EST BORNEE COMME L'EST LA MISE A JOUR — LES DEUX MOITIES DE LA PORTE.
      //
      // La regle `update` ci-dessous a recu une liste blanche exacte, et son commentaire
      // explique tres bien pourquoi : `referralCode` reecrit permet de capter les filleuls
      // d'un tiers, `referralRewarded` repose a `false` rouvre une double recompense. Cette
      // regle-ci, elle, ne verrouillait que `role` et `uid`. La porte fermee en ECRITURE
      // etait donc grande ouverte a la CREATION, et un profil se cree une fois par compte —
      // il suffit de s'inscrire.
      //
      // L'abus concret, verifie contre `functions/src/referrals.ts:31` : la recompense part a
      // `where('referralCode','==',code).limit(1)`, une requete SANS `orderBy`, que Firestore
      // resout donc par `__name__` croissant. Poser a l'inscription le `referralCode` d'un
      // tiers, avec un UID qui trie plus bas que le sien, detourne TOUTES ses conversions
      // futures. Les UID Firebase etant tires au hasard, c'est une chance sur deux par
      // compte recree — autant dire acquis.
      //
      // La liste ci-dessous est le miroir exact de ce que pose `AuthContext.tsx` (lignes
      // 116-122 pour l'e-mail, 151-157 pour Google), et rien de plus. Les trois champs de
      // parrainage en sont ABSENTS a dessein : ils se posent apres coup, par la regle
      // `update`, qui sait deja n'accepter qu'une seule pose et jamais un rejeu.
      // ─────────────────────────────────────────────────────────────────────────────
      allow create: if isSignedIn() &&
        request.auth.uid == userId &&
        request.resource.data.role == 'student' &&
        request.resource.data.uid == userId &&
        request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'role', 'createdAt', 'preferences',
          'firstName', 'lastName', 'phone', 'photoURL'
        ]);

      // ─────────────────────────────────────────────────────────────────────────────
      // LE PROPRIETAIRE N'ECRIT QUE LES CHAMPS DE SON PROFIL, PAS N'IMPORTE LESQUELS.
      //
      // L'ancienne regle ne verrouillait que `role` et `uid`. Tout le reste du document
      // etait libre — y compris des champs que le SERVEUR relit comme des gardes.
      //
      // `referralRewarded` en est un : `onReferralConversion` (functions/src/referrals.ts)
      // s'arrete sur `if (!u?.referredByCode || u.referralRewarded) return;`. C'est la
      // SEULE protection contre une double recompense de parrainage. Le champ n'est jamais
      // ecrit par le client, mais rien ne l'empechait de l'etre : reposer le drapeau a
      // `false` reouvrait la porte que le serveur croyait fermee.
      //
      // La liste ci-dessous est le miroir exact de `ALLOWED_PROFILE_FIELDS`
      // (src/lib/firestore/users.ts), qui filtre deja cote client. Le filtre client protege
      // des erreurs ; celui-ci protege des requetes forgees. Les deux doivent bouger
      // ENSEMBLE : un champ ajoute la-bas sans etre ajoute ici echouera silencieusement.
      //
      // Absents de la liste, donc immuables cote client : `role`, `uid`, `email`,
      // `createdAt`, `referralRewarded`.
      // ─────────────────────────────────────────────────────────────────────────────
      allow update: if isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'firstName', 'lastName', 'phone', 'avatar', 'bio', 'preferences',
          'birthDate', 'whatsapp', 'linkedin', 'photoURL', 'onboardingCompleted',
          'referralCode', 'referredByCode', 'tutorName',
          'city', 'website', 'facebook', 'instagram', 'twitter', 'tiktok', 'youtube'
        ]) &&
        // ── Les deux champs de parrainage se POSENT, ils ne se rejouent pas ──────────
        // `getOrCreateReferralCode()` n'ecrit `referralCode` que s'il est absent, et
        // `Register.tsx` sort sans rien faire quand `referredByCode` existe deja. Les
        // regles disent maintenant la meme chose, et c'est ce qui ferme deux abus :
        //   • recopier le `referralCode` d'un tiers pour capter ses filleuls — la
        //     recompense part a `where('referralCode','==',code).limit(1)`, donc au
        //     premier document trouve, pas forcement au bon ;
        //   • changer de parrain apres coup pour rejouer une conversion.
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['referralCode'])
         || !('referralCode' in resource.data)) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['referredByCode'])
         || !('referredByCode' in resource.data));

      // Only admins can delete users
      allow delete: if isAdmin();

      // Admins can update any user including role changes
      allow update: if isAdmin();
    }

    // Blog posts collection
    match /blog/{postId} {
      // Everyone can read published posts
      allow read: if resource.data.status == 'published' || isAdmin();

      // Only admins can create, update, or delete posts
      allow create, update, delete: if isAdmin();

      // Allow incrementing read counter by exactly +1 (public, from BlogPost page)
      allow update: if resource.data.status == 'published' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']) &&
        request.resource.data.views == (resource.data.views == null ? 0 : resource.data.views) + 1;
    }

    // Formations collection
    match /formations/{formationId} {
      // Everyone can read published formations
      allow read: if resource.data.status == 'published' || isAdmin();

      // Only admins can create, update, or delete formations
      allow create, update, delete: if isAdmin();
    }

    // Enrollments collection
    match /enrollments/{enrollmentId} {
      // Users can read their own enrollments, admins can read all
      allow read: if isOwner(resource.data.userId) || isAdmin();

      // ─────────────────────────────────────────────────────────────────────────────
      // AUTO-INSCRIPTION : RÉSERVÉE AUX FORMATIONS RÉELLEMENT GRATUITES.
      //
      // Cette règle disait « free courses » en commentaire et ne le vérifiait NULLE PART.
      // Elle n'exigeait que trois choses : être connecté, s'inscrire soi-même, et respecter
      // le format d'identifiant. Le prix de la formation n'était jamais lu.
      //
      // Conséquence : n'importe quel compte connecté pouvait écrire
      // `enrollments/{sonUid}_{idDUneFormationPayante}` et obtenir l'accès complet à une
      // formation vendue, sans transaction. Le garde `isFree` existe bien — mais dans
      // `Checkout.tsx`, c'est-à-dire dans le navigateur, donc chez la personne qui contourne.
      //
      // Le prédicat ci-dessous calque EXACTEMENT celui du client (`promoPrice ?? price`),
      // pour qu'un catalogue à prix promotionnel nul reste inscriptible et qu'aucun parcours
      // gratuit légitime ne casse. `status == 'published'` s'y ajoute : on ne s'inscrit pas
      // à un brouillon.
      //
      // `get()` coûte une lecture par inscription. C'est le prix d'une vérification côté
      // serveur, et il se paie une fois par personne et par formation.
      // ─────────────────────────────────────────────────────────────────────────────
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        enrollmentId == (request.auth.uid + '_' + request.resource.data.formationId) &&
        isFreeFormation(request.resource.data.formationId);

      // Admins can create enrollments manually; payment webhook creates paid ones
      allow create: if isAdmin();

      // Users can update their own progress, but only a fixed set of fields
      // (no arbitrary writes / mass-assignment) and progress stays in [0,100].
      // Progress is NOT a security gate for certificates anymore (the
      // issueCertificate Cloud Function re-derives completion server-side), so
      // progress may decrease (users can un-mark a lesson as complete).
      //
      // `maxProgress` est le repere de progression la plus haute jamais atteinte. Il ne
      // pilote aucun droit : il sert uniquement a n'accorder l'XP d'apprentissage qu'une
      // fois par palier franchi. Sans lui, decocher puis recocher une lecon rapportait de
      // l'XP en boucle -- et cet XP alimente le classement et les badges de parrainage.
      // Il ne peut donc que croitre, meme quand `progress` redescend.
      allow update: if isOwner(resource.data.userId) &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.formationId == resource.data.formationId &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['completedLessons', 'progress', 'lastActivityAt', 'certificateIssued', 'maxProgress']) &&
        request.resource.data.progress >= 0 &&
        request.resource.data.progress <= 100 &&
        request.resource.data.get('maxProgress', 0) >= resource.data.get('maxProgress', 0) &&
        request.resource.data.get('maxProgress', 0) <= 100;

      // Admins can update any enrollment (for manual enrollments, refunds, etc.)
      allow update: if isAdmin();

      // Only admins can delete enrollments
      allow delete: if isAdmin();
    }

    // Podcasts collection
    match /podcasts/{podcastId} {
      // Published podcasts are readable by all; drafts only by admins
      allow read: if resource.data.status == 'published' || isAdmin();

      // Only admins can create, update, or delete
      allow create, update, delete: if isAdmin();
    }

    // Videos collection
    match /videos/{videoId} {
      // Published videos are readable by all; drafts only by admins
      allow read: if resource.data.status == 'published' || isAdmin();

      // Only admins can create, update, or delete
      allow create, update, delete: if isAdmin();

      // Allow incrementing view count — sur une video PUBLIEE uniquement.
      // `blog` posait deja cette condition ; ici elle manquait, et un brouillon invisible
      // pouvait voir son compteur monter, ce qui revient a confirmer son existence.
      allow update: if resource.data.status == 'published' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']) &&
        request.resource.data.views == (resource.data.views == null ? 0 : resource.data.views) + 1;
    }

    // Testimonials collection
    match /testimonials/{testimonialId} {
      // Everyone can read featured/approved testimonials; users can read their own; admins read all
      allow read: if resource.data.featured == true ||
        resource.data.status == 'approved' ||
        (isSignedIn() && resource.data.userId == request.auth.uid) ||
        isAdmin();

      // Admins create freely (seed / manual). Students submit their own as pending, not featured.
      allow create: if isAdmin() ||
        (isSignedIn() &&
         request.resource.data.userId == request.auth.uid &&
         request.resource.data.status == 'pending' &&
         request.resource.data.featured == false);

      // Only admins can update testimonials
      allow update: if isAdmin();

      // Admins delete any; users can remove their own as long as it's still pending
      allow delete: if isAdmin() ||
        (isSignedIn() &&
         resource.data.userId == request.auth.uid &&
         resource.data.status == 'pending');
    }

    // FAQ collection
    match /faq/{faqId} {
      // Everyone can read FAQs
      allow read: if true;

      // Only admins can manage FAQs
      allow create, update, delete: if isAdmin();
    }

    // Appointments collection
    match /appointments/{appointmentId} {
      // ─────────────────────────────────────────────────────────────────────────────
      // CE DOCUMENT DICTE UN ENVOI D'E-MAIL — IL SE VALIDE COMME TEL.
      //
      // `acknowledgeAppointment` (Worker api) relit ce document et envoie un courrier a
      // l'adresse qu'il porte, depuis `mail.maxmorrys.me`, signe SPF/DKIM. Le handler s'en
      // remet a cette regle pour la forme de ce qu'il enverra : c'est ICI, et nulle part
      // ailleurs, que se decide ce qui peut entrer dans un courrier sortant.
      //
      // Ce qui manquait, et qui n'etait pas une omission de detail :
      //   • `email` n'etait verifie que par sa LONGUEUR — « aaaaa » etait une adresse ;
      //   • `subject` et `time` n'apparaissaient dans AUCUNE contrainte, alors que les deux
      //     sont recopies dans le corps du message. Le plafond `keys().size() <= 12` bornait
      //     leur NOMBRE, jamais leur contenu : un « objet » de dix mille caracteres passait ;
      //   • `date` n'etait borne ni en longueur ni en forme.
      //
      // `hasOnly()` remplace le comptage de cles. Un plafond numerique laisse passer
      // n'importe quel champ tant qu'on n'en met pas trop ; une liste dit lesquels. C'est la
      // meme correction que sur `users` : la porte se ferme en nommant ce qui entre.
      //
      // ⚠️ La liste est le miroir de `saveAppointment()` (src/lib/firestore/content.ts:138)
      // et de `handleSubmit` (src/pages/contact/useAppointment.ts). Les trois bougent ENSEMBLE :
      // un champ ajoute au formulaire sans etre ajoute ici echoue silencieusement.
      // ─────────────────────────────────────────────────────────────────────────────
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'date', 'type'])
        && request.resource.data.keys().hasOnly([
             'name', 'email', 'phone', 'date', 'time', 'type', 'subject', 'message',
             'status', 'createdAt'
           ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 254
        // Une adresse, pas une chaine de cinq caracteres. `matches()` porte sur la chaine
        // entiere : pas d'espace, un seul arobase, un domaine avec extension alphabetique.
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[a-zA-Z]{2,}$')
        && request.resource.data.date is string
        && request.resource.data.date.size() <= 40
        && request.resource.data.type is string
        && request.resource.data.type.size() <= 60
        && (!('time' in request.resource.data)
            || (request.resource.data.time is string
                && request.resource.data.time.size() <= 10))
        // `subject` finit dans le corps du courrier : c'est le champ par lequel un texte
        // choisi par l'appelant atteignait son destinataire. 120 caracteres suffisent a
        // l'intitule que pose le formulaire, et ne suffisent a rien d'autre.
        && (!('subject' in request.resource.data)
            || (request.resource.data.subject is string
                && request.resource.data.subject.size() <= 120))
        && (!('phone' in request.resource.data)
            || (request.resource.data.phone is string
                && request.resource.data.phone.size() <= 30))
        && (!('message' in request.resource.data)
            || (request.resource.data.message is string
                && request.resource.data.message.size() <= 2000))
        // Un visiteur ne se declare pas confirme : le statut appartient a la console.
        && (!('status' in request.resource.data)
            || request.resource.data.status == 'pending');

      // Admins and support can read and update appointments
      allow read, update: if isAdminOrSupport();

      // Only admins can delete
      allow delete: if isAdmin();
    }

    // Contact messages collection
    match /messages/{messageId} {
      // Users can read their own messages, admins and support can read all
      allow read: if isOwner(resource.data.userId) || isAdminOrSupport();

      // Anyone can create a contact message (even non-authenticated)
      // Validation : champs requis + tailles max pour limiter le spam
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'message'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 5000
        // `userId` VIENT D'ÊTRE OUVERT À L'ÉCRITURE PAR LE FORMULAIRE PUBLIC, et c'est lui
        // qui décide de la lecture juste au-dessus (`isOwner(resource.data.userId)`). Sans
        // cette borne, n'importe qui pourrait déposer un message dans la boîte d'un tiers en
        // recopiant son UID. Un visiteur déconnecté écrit `null` ; une personne connectée ne
        // peut écrire que le sien.
        && (!request.resource.data.keys().hasAny(['userId'])
            || request.resource.data.userId == null
            || request.resource.data.userId == request.auth.uid)
        // Meme borne que les autres formulaires publics : name, email, message, subject,
        // phone, userId, status, locale, createdAt, et un peu de marge.
        && request.resource.data.keys().size() <= 12
        // Le traitement d'un message appartient a la console, pas a son expediteur.
        && (!('status' in request.resource.data)
            || request.resource.data.status == 'new');

      // Only admins and support can update (to mark as read/replied)
      allow update: if isAdminOrSupport();

      // Only admins can delete
      allow delete: if isAdmin();
    }

    // Engagement leads — demandes de mission Max-Morrys Agency (page /agence)
    //
    // A ne pas confondre avec agency_leads plus bas : ce sont deux offres distinctes.
    // Ici, missions produit/IA/technologie high-ticket ; la-bas, packs "Digital Commerce
    // Local" pour commerces de proximite. Cf. docs/AGENCY-POSITIONING.md
    match /engagement_leads/{leadId} {
      // Le formulaire public /agence est accessible sans compte — validation stricte des champs
      allow create: if request.resource.data.keys().hasAll(
          ['name', 'company', 'email', 'projectType', 'budget', 'timeline', 'description', 'status'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.company is string
        && request.resource.data.company.size() >= 2
        && request.resource.data.company.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 254
        && request.resource.data.projectType is string
        && request.resource.data.projectType.size() <= 30
        && request.resource.data.budget is string
        && request.resource.data.budget.size() <= 30
        && request.resource.data.timeline is string
        && request.resource.data.timeline.size() <= 30
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 40
        && request.resource.data.description.size() <= 4000
        // Un prospect ne peut pas se declarer qualifie, en cours de cadrage ou gagne.
        && request.resource.data.status == 'new'
        && (!('website' in request.resource.data)
            || (request.resource.data.website is string && request.resource.data.website.size() <= 200))
        && (!('routedTo' in request.resource.data)
            || request.resource.data.routedTo == 'MY_ONOMA_GROW')
        && (!('locale' in request.resource.data)
            || request.resource.data.locale in ['fr', 'en'])
        // Les notes internes ne peuvent jamais etre posees par le prospect
        && !('notes' in request.resource.data)
        // Slug du site client d'ou vient le prospect (`/via/<slug>` -> `?via=`).
        // Jamais une donnee du visiteur : c'est le site emetteur qui est identifie.
        && (!('via' in request.resource.data)
            || (request.resource.data.via is string
                && request.resource.data.via.size() > 0
                && request.resource.data.via.size() <= 64))
        // Borne le nombre de champs : empeche le bourrage de document par un robot.
        // Maximum legitime = 12 (7 obligatoires + website + routedTo + locale + via
        // + status), soit 13 avec createdAt pose par createDoc.
        && request.resource.data.keys().size() <= 13;

      // Pipeline commercial : lecture et qualification par admin et support
      allow read, update: if isAdminOrSupport();

      // Only admins can delete
      allow delete: if isAdmin();
    }

    // Agency leads collection — demandes de devis "Presence Digitale" (cf. docs/OFFRE_AGENCE_TPE.md)
    match /agency_leads/{leadId} {
      // Le formulaire public /presence-digitale est accessible sans compte — validation stricte
      allow create: if request.resource.data.keys().hasAll(['businessName', 'contactName', 'phone', 'city', 'status'])
        && request.resource.data.businessName is string
        && request.resource.data.businessName.size() >= 2
        && request.resource.data.businessName.size() <= 120
        && request.resource.data.contactName is string
        && request.resource.data.contactName.size() >= 2
        && request.resource.data.contactName.size() <= 100
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 6
        && request.resource.data.phone.size() <= 30
        && request.resource.data.city is string
        && request.resource.data.city.size() <= 80
        && request.resource.data.status == 'new'
        && (!('email' in request.resource.data)
            || (request.resource.data.email is string && request.resource.data.email.size() <= 254))
        && (!('message' in request.resource.data)
            || (request.resource.data.message is string && request.resource.data.message.size() <= 2000))
        && (!('referralCode' in request.resource.data)
            || (request.resource.data.referralCode is string && request.resource.data.referralCode.size() <= 40))
        // Borne le nombre de champs : empeche le bourrage de document par un robot.
        // Maximum legitime = 14 (8 obligatoires + 3 optionnels + status + createdAt + quoteRef).
        && request.resource.data.keys().size() <= 15
        && (!('quoteRef' in request.resource.data)
            || (request.resource.data.quoteRef is string && request.resource.data.quoteRef.size() <= 20))
        // Les notes internes ne peuvent jamais etre posees par le prospect
        && !('notes' in request.resource.data);

      // Pipeline commercial : lecture et qualification par admin et support
      allow read, update: if isAdminOrSupport();

      // Only admins can delete
      allow delete: if isAdmin();
    }

    // Agency quotes — devis partageables par lien (cf. docs/OFFRE_AGENCE_TPE.md)
    //
    // Le document est lisible par QUICONQUE possede la reference (URL non devinable,
    // ~2,8e14 combinaisons). Il ne doit donc contenir AUCUNE donnee personnelle :
    // telephone, email, nom du contact et message restent dans agency_leads.
    // L'interdiction est imposee ici, cote serveur, et pas seulement dans le code client.
    match /agency_quotes/{quoteRef} {
      // get par ID exacte uniquement. Jamais de list : sans la reference, rien n'est atteignable.
      allow get: if true;
      allow list: if isAdminOrSupport();

      allow create: if request.resource.data.keys().hasAll(
          ['businessName', 'city', 'pack', 'plan', 'packPrice', 'planSetup', 'planMonthly', 'createdAt'])
        // Aucune donnee personnelle, sous aucun pretexte
        && !('phone' in request.resource.data)
        && !('email' in request.resource.data)
        && !('contactName' in request.resource.data)
        && !('message' in request.resource.data)
        && !('notes' in request.resource.data)
        && !('referralCode' in request.resource.data)
        && request.resource.data.businessName is string
        && request.resource.data.businessName.size() >= 2
        && request.resource.data.businessName.size() <= 120
        && request.resource.data.city is string
        && request.resource.data.city.size() <= 80
        && request.resource.data.pack is string
        && request.resource.data.plan is string
        && request.resource.data.packPrice is int
        && request.resource.data.packPrice >= 0
        && request.resource.data.packPrice <= 5000000
        && request.resource.data.planSetup is int
        && request.resource.data.planSetup >= 0
        && request.resource.data.planSetup <= 5000000
        && request.resource.data.planMonthly is int
        && request.resource.data.planMonthly >= 0
        && request.resource.data.planMonthly <= 1000000
        && request.resource.data.keys().size() <= 11;

      // Un devis est immuable une fois emis : seul un admin peut le corriger ou le purger.
      allow update, delete: if isAdmin();
    }

    // Newsletter subscribers collection
    match /newsletter/{subscriberId} {
      // Only admins can read subscribers
      allow read: if isAdmin();

      // Anyone can subscribe — with field validation
      //
      // Le consentement est exige cote serveur, pas seulement dans le formulaire :
      // une inscription sans `consent == true` est refusee. `consentAt` horodate le recueil.
      //
      // ⚠️ Le plafond de cles est passe de 3 a 5 EN MEME TEMPS que l'ajout de ces deux
      // champs. Les dissocier ferait echouer 100% des inscriptions.
      //
      // ⚠️ ET IL EST REPASSE DE 5 A 6 POUR `locale`, POUR LA MEME RAISON.
      // Le plafond etait EXACTEMENT atteint : les cinq champs poses par le formulaire
      // occupaient les cinq places. Ajouter `locale` sans lever le plafond aurait fait
      // echouer 100% des inscriptions, silencieusement, cote client.
      //
      // `locale` est indispensable et n'a pas de substitut : un abonne a la lettre n'a pas
      // forcement de compte, donc pas de `users/{uid}.preferences.language` ou lire sa
      // langue. Sans ce champ, la lettre part en francais a tout le monde.
      //
      // `unsubscribedAt` n'est PAS dans cette liste, et c'est deliberе : il est ecrit par le
      // Worker via son compte de service, qui ne passe pas par ces regles. Un client ne doit
      // pas pouvoir desabonner une adresse qui n'est pas la sienne en forgeant une creation.
      allow create: if request.resource.data.keys().hasAll(['email', 'consent'])
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 254
        && request.resource.data.consent == true
        && (!('consentAt' in request.resource.data)
            || request.resource.data.consentAt is string)
        && (!('locale' in request.resource.data)
            || request.resource.data.locale in ['fr', 'en'])
        && request.resource.data.keys().size() <= 6;

      // Only admins can update or delete
      allow update, delete: if isAdmin();
    }

    // Transactions collection
    match /transactions/{transactionId} {
      // Users can read their own transactions, admins can read all
      allow read: if isOwner(resource.data.userId) || isAdmin();

      // ─────────────────────────────────────────────────────────────────────────────
      // UNE TRANSACTION « GRATUITE » DOIT PORTER SUR UNE FORMATION REELLEMENT GRATUITE.
      //
      // La regle se contentait de trois affirmations que l'ECRIVAIN fournissait lui-meme :
      // `status: 'completed'`, `paymentMethod: 'free'`, `amount: 0`. Aucune ne dit quoi que
      // ce soit sur le prix reel du produit. N'importe quel compte pouvait donc deposer une
      // vente soldee a zero sur la formation la plus chere du catalogue.
      //
      // L'acces au contenu ne s'en trouvait pas ouvert — `enrollments` verifie le prix
      // depuis le commit precedent. Mais la comptabilite, elle, prend tout : le tableau de
      // bord admin, le chiffre d'affaires et les relances par courriel lisent cette
      // collection. Une transaction inventee y reste indiscernable d'une vraie.
      //
      // `isFreeFormation()` est exactement le predicat que `enrollments` applique deja :
      // les deux ecritures d'un parcours gratuit racontent maintenant la meme histoire.
      // ─────────────────────────────────────────────────────────────────────────────
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'completed' &&
        request.resource.data.paymentMethod == 'free' &&
        request.resource.data.amount == 0 &&
        request.resource.data.formationId is string &&
        isFreeFormation(request.resource.data.formationId);

      // Admins can record a transaction manually (manual enrollment, correction)
      allow create: if isAdmin();

      // Only admins can update (for refunds, status changes)
      allow update: if isAdmin();

      // Only admins can delete
      allow delete: if isAdmin();
    }

    // Coupons collection
    //
    // ─────────────────────────────────────────────────────────────────────────────
    // LES CODES PROMO NE SONT PLUS LISIBLES PUBLIQUEMENT.
    //
    // La regle disait « everyone can read active coupons to validate them ». Personne
    // ne les validait ici : la seule validation qui compte vit dans `validateCoupon`
    // (functions/src/payment.ts), executee par le SDK Admin, qui relit la collection
    // en contournant ces regles. Le client n'envoie qu'un `couponCode` au callable.
    //
    // Ce que la lecture ouverte offrait, en revanche : `where('active','==',true)`
    // depuis n'importe quel navigateur rendait TOUS les codes en cours, avec leur
    // valeur, leur type et leur plafond d'utilisations — un catalogue de reductions
    // servi a qui le demande, sans compte.
    //
    // Verifie avant fermeture : `getAllCoupons()` n'est appele que par
    // `AdminCoupons.tsx`. Aucun parcours public ne lit la collection.
    // ─────────────────────────────────────────────────────────────────────────────
    match /coupons/{couponId} {
      allow read: if isAdmin();

      // Only admins can manage coupons
      allow create, update, delete: if isAdmin();
    }

    // Announcements collection
    match /announcements/{announcementId} {
      // Everyone can read active announcements
      allow read: if resource.data.active == true || isAdmin();

      // Only admins can manage announcements
      allow create, update, delete: if isAdmin();
    }

    // Analytics collection (for storing analytics data)
    match /analytics/{docId} {
      // Only admins can read analytics
      allow read: if isAdmin();

      // Backend can write analytics
      allow create, update: if false;

      // Only admins can delete
      allow delete: if isAdmin();
    }

    // User activity logs (for admin dashboard)
    match /activity_logs/{logId} {
      // Only admins can read logs
      allow read: if isAdmin();

      // System can create logs
      allow create: if false;

      // Nobody can update or delete logs (immutable audit trail)
      allow update, delete: if false;
    }

    // Referrals (parrainage) — créés par Cloud Function ; le parrain lit les siens
    match /referrals/{referralId} {
      allow read: if isSignedIn() && resource.data.referrerId == request.auth.uid || isAdmin();
      allow write: if false; // backend only (Admin SDK)
    }

    // Public leaderboard aggregate (denormalized top members, maintained by Cloud Functions)
    match /leaderboard/{docId} {
      // Any signed-in user can read the aggregate
      allow read: if isSignedIn();
      // Only the backend (Admin SDK) may write — never from the client
      allow write: if false;
    }

    // Gamification profiles (XP, streaks, badges)
    match /gamification/{userId} {
      // Users can read only their own profile; admins can read all. (A signed-in
      // read of every profile leaked all members' XP/streaks/badges.) For a
      // leaderboard, expose a dedicated server-maintained aggregate doc instead.
      allow read: if isOwner(userId) || isAdmin();

      // Users can create/update their own profile, but values are BOUNDED so a
      // client cannot self-award arbitrary XP/badges (which feed the public
      // leaderboard and referral/badge rewards). Legit client writes only ever
      // add small XP increments (max single reward = 200), grow the streak by +1,
      // or append a single badge. NOTE: validate with the Firestore emulator
      // (rules-unit-testing) before deploying. The long-term fix is to move all
      // gamification writes server-side (Cloud Functions) — see audit S2.
      //
      // AJOUT : la forme du document est fermee. Les bornes ci-dessous ne portent que sur
      // cinq champs ; rien n'empechait d'en poser un sixieme. Or `rebuildLeaderboard` et
      // les badges de parrainage relisent ce document cote serveur, et un champ inconnu
      // qui s'y glisse est un champ que personne n'a valide. `hasOnly` fige le contrat sur
      // `GamificationProfile` (src/types/gamification.ts) — les deux bougent ensemble.
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(
             ['xp', 'level', 'currentStreak', 'longestStreak', 'lastActiveDate', 'badges'])
        && request.resource.data.xp <= 500
        && request.resource.data.level >= 1 && request.resource.data.level <= 10
        && request.resource.data.currentStreak <= 1
        && request.resource.data.badges.size() <= 1;
      allow update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(
             ['xp', 'level', 'currentStreak', 'longestStreak', 'lastActiveDate', 'badges'])
        && request.resource.data.xp >= resource.data.xp
        && request.resource.data.xp <= resource.data.xp + 500
        && request.resource.data.level >= 1 && request.resource.data.level <= 10
        && request.resource.data.currentStreak <= resource.data.currentStreak + 1
        && request.resource.data.badges.size() <= resource.data.badges.size() + 1;

      // Only admins can delete
      allow delete: if isAdmin();
    }

    // Certificates collection
    match /certificates/{certificateId} {
      // Users can read their own certificates
      allow read: if isOwner(resource.data.userId) || isAdmin();

      // Certificates are issued only by the issueCertificate Cloud Function,
      // which re-derives real completion server-side. Clients cannot self-issue
      // (the old rule trusted the client-writable `progress` field).
      allow create: if false;

      // Nobody can update certificates (immutable)
      allow update: if false;

      // Only admins can delete (in case of fraud)
      allow delete: if isAdmin();
    }

    // Miroir public d'un certificat, indexe PAR LE CODE de verification.
    //
    // Pourquoi cette collection existe : `certificates` est identifie par
    // {uid}_{formationId}. Une page de verification qui ne connait que le code devait
    // donc faire une requete de LISTE sur `certificates` -- que la regle ci-dessus
    // refuse, y compris au proprietaire, puisque la requete n'est pas filtree sur
    // userId. La verification publique etait donc cassee pour tout le monde.
    //
    // Ouvrir `certificates` en lecture aurait permis d'enumerer tous les certificats
    // emis, donc de compter les clients, et aurait expose les UID. Ce miroir ne porte
    // que ce qu'un certificat affiche deja a l'ecran, et son identifiant EST le code :
    // la verification est un `get` direct, jamais une liste.
    //
    // Ecrit exclusivement par la Cloud Function issueCertificate (SDK Admin, qui
    // contourne les regles) et par le backfill reserve aux admins.
    match /certificate_lookups/{certificateCode} {
      allow read: if true;
      allow write: if false;
    }

    // Miroir public des chiffres du Club — ecrit par le Worker (compte de service, qui
    // contourne ces regles), lu par la page publique /club-des-digitos.
    //
    // Il existe parce qu'un ENGAGEMENT affiche avant paiement — « deux sessions en direct
    // par mois » — ne se verifiait pas : club_events exige un abonnement actif en lecture,
    // une agregation passe par la meme regle, et cette fermeture est voulue. Le miroir
    // publie donc l'EXECUTION de l'engagement : le nombre de sessions reellement tenues sur
    // une fenetre datee, compte cote serveur.
    //
    // ⚠️ Aucun chiffre de preuve sociale n'entrera ici : ni nombre de membres, ni note, ni
    // avis, ni temoignage. Le compte de membres existe deja dans leaderboard/global,
    // reserve aux connectes, et il n'en sort pas.
    //
    // ⚠️ Aucune ecriture cliente, pas meme admin : un chiffre que le navigateur pourrait
    // poser ne prouverait plus rien, et c'est la seule raison pour laquelle celui-la vaut
    // quelque chose.
    match /public_stats/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // User progress in lessons (subcollection under enrollments)
    match /enrollments/{enrollmentId}/progress/{lessonId} {
      // Users can read their own progress
      allow read: if isOwner(get(/databases/$(database)/documents/enrollments/$(enrollmentId)).data.userId) || isAdmin();

      // Users can update their own progress
      allow create, update: if isOwner(get(/databases/$(database)/documents/enrollments/$(enrollmentId)).data.userId);

      // Admins can manage progress
      allow create, update, delete: if isAdmin();
    }

    // Table de redirections servie au bord (`/via/<slug>`, 301 de SEO).
    match /redirects/{redirectId} {
      // Aucune lecture publique : le Worker `maxmorrys-site` lit par compte de
      // service, donc hors de ces regles. Personne d'autre n'a besoin de la table.
      allow read, create, update, delete: if isAdmin();
    }

    // Site settings (single document)
    match /settings/site {
      // Everyone can read site settings (for public info like site name, colors)
      allow read: if true;

      // Admins can create or update settings
      allow create, update: if isAdmin();

      // Cannot delete the settings document
      allow delete: if false;
    }

    // User notes (personal notes per student)
    match /users/{userId}/notes/{noteId} {
      allow read, create, update, delete: if isOwner(userId);
      allow read: if isAdmin();
    }

    // Engagement contenus (consultations, temps, scroll, minutes média) — pour la mémoire Rysmo
    match /users/{userId}/engagement/{contentId} {
      allow read, create, update: if isOwner(userId);
      allow read: if isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Notifications preferences (per user)
    match /users/{userId}/notifications/{notificationId} {
      // Users can read and manage their own notification preferences
      allow read, create, update, delete: if isOwner(userId);

      // Admins can read all
      allow read: if isAdmin();
    }

    // Club des Digitos — abonnements
    match /club_subscriptions/{userId} {
      // L'utilisateur peut lire son propre abonnement (StudentDashboard)
      allow read: if isOwner(userId) || isAdmin();

      // L'utilisateur ne peut créer qu'avec status 'pending' (pas d'auto-activation)
      allow create: if isOwner(userId) &&
        request.resource.data.status == 'pending';

      // L'utilisateur ne peut PAS changer le status lui-même
      allow update: if isOwner(userId) &&
        request.resource.data.status == resource.data.status;

      // L'admin peut tout créer/mettre à jour (activation manuelle, etc.)
      allow create, update: if isAdmin();

      // Seul l'admin peut supprimer
      allow delete: if isAdmin();
    }

    // Club des Digitos — posts du feed
    // Club challenges (défis hebdomadaires) — lecture membres actifs, écriture admin
    match /club_challenges/{challengeId} {
      allow read: if hasActiveClubSub() || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Annuaire des membres — profil opt-in ; lecture membres actifs, écriture sur son propre profil ; admin modère
    match /club_profiles/{userId} {
      allow read: if hasActiveClubSub() || isAdmin();
      allow create, update: if (isOwner(userId) && hasActiveClubSub()
        && request.resource.data.userId == request.auth.uid) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Opportunités (job board) — lecture membres actifs ; l'auteur crée/supprime les siennes
    match /club_opportunities/{oppId} {
      allow read: if hasActiveClubSub() || isAdmin();
      allow create: if hasActiveClubSub() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // Messagerie privée 1-à-1 — accessible aux seuls participants
    match /conversations/{convId} {
      // resource == null autorise le get d'une conversation inexistante (étape getOrCreate)
      allow read: if isSignedIn() && (resource == null || request.auth.uid in resource.data.participants);
      allow create: if hasActiveClubSub()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;
      // Participants peuvent mettre à jour l'aperçu (dernier message) ; pas de changement de participants
      allow update: if isSignedIn() && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants;
      allow delete: if isAdmin();

      match /messages/{msgId} {
        function convParticipants() {
          return get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
        }
        allow read: if isSignedIn() && request.auth.uid in convParticipants();
        allow create: if hasActiveClubSub()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in convParticipants();
        // Messages immuables ; l'admin peut supprimer un message signalé (modération)
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // Signalements de messages privés — créés par un membre actif, lus/traités par admin
    match /dm_reports/{reportId} {
      allow create: if hasActiveClubSub() && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    match /club_posts/{postId} {
      // Membres actifs et admins peuvent lire
      allow read: if hasActiveClubSub() || isAdmin();

      // Membres actifs peuvent créer leurs propres posts
      allow create: if (hasActiveClubSub() || isAdmin())
        && request.auth.uid == request.resource.data.userId;

      // ─────────────────────────────────────────────────────────────────────────────
      // L'AUTEUR EDITE SON TEXTE. IL NE TOUCHE NI A LA PROPRIETE, NI AUX COMPTEURS.
      //
      // Le commentaire annoncait « userId immuable » et RIEN ne le verifiait : la premiere
      // branche laissait l'auteur reecrire le document entier. Deux consequences, l'une
      // discrete et l'autre pas :
      //   • `userId` reattribuable — le post change de main, et avec lui le droit de le
      //     supprimer, qui se lit sur ce meme champ ;
      //   • `likes` et `reposts` librement reecrits par l'auteur du post, c'est-a-dire
      //     par la seule personne qui a interet a les gonfler.
      //
      // La branche « membre » avait le meme trou dans l'autre sens : `hasOnly([...])` dit
      // QUELS champs bougent, jamais COMMENT. `commentsCount` etait borne a plus ou moins
      // un ; les deux tableaux, eux, passaient en entier. `togglesOwnMark` les traite comme
      // `pollVotes` l'etait deja : une bascule, pour soi seul.
      // ─────────────────────────────────────────────────────────────────────────────
      allow update: if isAdmin()
        // L'auteur : contenu du post, jamais la propriete ni les compteurs sociaux
        || (isSignedIn() && resource.data.userId == request.auth.uid &&
            request.resource.data.userId == resource.data.userId &&
            !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['likes', 'reposts', 'commentsCount', 'pollVotes', 'createdAt']))
        // Un membre aime ou repartage — un seul identifiant, le sien
        || (hasActiveClubSub() &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']) &&
            togglesOwnMark('likes'))
        || (hasActiveClubSub() &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reposts']) &&
            togglesOwnMark('reposts'))
        // Le compteur de commentaires suit l'ajout ou le retrait d'un commentaire
        || (hasActiveClubSub() &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentsCount']) &&
            (request.resource.data.commentsCount == resource.data.commentsCount + 1
             || request.resource.data.commentsCount == resource.data.commentsCount - 1))
        // Poll vote: a member may only add/change their OWN key in pollVotes
        || (hasActiveClubSub() &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pollVotes']) &&
            request.resource.data.pollVotes.diff(resource.data.pollVotes).affectedKeys().hasOnly([request.auth.uid]));

      // L'auteur ou l'admin peut supprimer
      allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();

      // Commentaires (sous-collection)
      match /comments/{commentId} {
        allow read: if hasActiveClubSub() || isAdmin();
        allow create: if (hasActiveClubSub() || isAdmin())
          && request.auth.uid == request.resource.data.userId;
        allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
        allow update: if false;
      }
    }

    // Club des Digitos — événements (lecture membres, écriture admin)
    match /club_events/{eventId} {
      allow read: if hasActiveClubSub() || isAdmin();
      allow create, update, delete: if isAdmin();

      // Inscriptions aux événements (sous-collection)
      match /registrations/{userId} {
        allow read, create, delete: if (hasActiveClubSub() || isAdmin()) && isOwner(userId);
        allow read: if isAdmin();
      }
    }

    // Club des Digitos — sessions live (lecture membres, écriture admin)
    match /club_sessions/{sessionId} {
      allow read: if hasActiveClubSub() || isAdmin();
      allow create, update, delete: if isAdmin();

      // Inscriptions aux sessions live (sous-collection)
      match /registrations/{userId} {
        allow read, create, delete: if (hasActiveClubSub() || isAdmin()) && isOwner(userId);
        allow read: if isAdmin();
      }
    }

    // Club des Digitos — infos exclusives (lecture membres, like membres, écriture admin)
    match /club_infos/{infoId} {
      allow read: if hasActiveClubSub() || isAdmin();
      // Les membres peuvent liker — une bascule, sur leur propre identifiant.
      // `hasOnly(['likes'])` disait quel champ bouge, pas comment : le tableau entier
      // pouvait etre remplace. Cf. `togglesOwnMark`.
      allow update: if hasActiveClubSub() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']) &&
        togglesOwnMark('likes');
      allow create, update, delete: if isAdmin();
    }

    // Notifications collection (per-user subcollection)
    match /notifications/{userId}/items/{notificationId} {
      // Users can read their own notifications
      allow read: if isOwner(userId);

      // « Mark as read » veut dire marquer comme lue, et rien d'autre : la regle ouvrait
      // le document entier, donc le titre, le lien et la date de ce que le serveur avait
      // envoye. Une notification est un message recu — son contenu n'appartient pas a
      // celui qui la lit.
      allow update: if isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);

      // Only backend/admin can create notifications
      allow create: if isAdmin();

      // Users can delete their own notifications
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Rate limiting collection (backend only — écrit uniquement par les Cloud Functions)
    match /_ratelimits/{docId} {
      allow read, write: if false;
    }

    // Rysmo+ abonnements (lite, pro) — création/maj par Cloud Function uniquement
    match /rysmoSubscriptions/{subscriptionId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Rysmo packs de requêtes — création/maj par Cloud Function uniquement
    match /rysmoPackPurchases/{purchaseId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Rysmo — profil d'apprenant résumé (lecture par l'owner pour la page transparence)
    match /rysmoProfiles/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false; // écriture serveur uniquement (Cloud Functions)
    }

    // Rysmo — logs bruts de conversation (100% privé/serveur)
    match /rysmoConversations/{userId} {
      allow read, write: if false;
    }

    // Webhook idempotency log (backend only)
    match /webhook_events/{chargeId} {
      allow read, write: if false;
    }

    // GDPR data exports (owner read only, backend writes)
    match /data_exports/{exportId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update, delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────────────
    // LISTE D'ATTENTE DES FORMATIONS A VENIR.
    //
    // ECRITURE SERVEUR UNIQUEMENT, et ce n'est pas une precaution de principe : s'inscrire
    // incremente aussi `formations/{id}.waitlistCount`, un document en ecriture ADMIN. Le
    // compteur denormalise est la seule facon d'afficher une preuve sociale, puisque cette
    // collection n'est pas listable publiquement — le faire tenir cote client aurait donc
    // exige d'ouvrir `formations` en ecriture a tout le monde. Le callable `joinWaitlist`
    // ecrit les deux documents dans une transaction.
    //
    // `get` est ouvert au proprietaire, `list` ne l'est pas : l'identifiant est determinist
    // (`{uid}_{formationId}`), donc la fiche sait si la personne est deja inscrite en lisant
    // UN document. Ouvrir le `list` aurait livre les adresses de toute la liste.
    // ─────────────────────────────────────────────────────────────────────────────────
    match /waitlist/{entryId} {
      allow get: if isAdminOrSupport() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdminOrSupport();
      allow write: if false;
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
