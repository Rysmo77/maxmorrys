rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isAdminOrSupport() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'support'];
    }

    function isEnrolled(formationId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + formationId));
    }

    function hasActiveClubSub() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/club_subscriptions/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/club_subscriptions/$(request.auth.uid)).data.status == 'active';
    }

    // Users collection
    match /users/{userId} {
      // Users can read their own profile; admins can read all
      allow read: if isOwner(userId) || isAdmin();

      // Users can only create their own profile during signup
      allow create: if isSignedIn() &&
        request.auth.uid == userId &&
        request.resource.data.role == 'student' &&
        request.resource.data.uid == userId;

      // Users can update their own profile, but cannot change their role
      allow update: if isOwner(userId) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.uid == resource.data.uid;

      // Only admins can delete users
      allow delete: if isAdmin();

      // Admins can update any user including role changes
      allow update: if isAdmin();
    }

    // Blog posts collection
    match /blog/{postId} {
      // Everyone can read published posts
      allow read: if resource.data.status == 'published' || isAdmin();

      // Only admins can create, update, or delete posts
      allow create, update, delete: if isAdmin();
    }

    // Formations collection
    match /formations/{formationId} {
      // Everyone can read published formations
      allow read: if resource.data.status == 'published' || isAdmin();

      // Only admins can create, update, or delete formations
      allow create, update, delete: if isAdmin();
    }

    // Enrollments collection
    match /enrollments/{enrollmentId} {
      // Users can read their own enrollments, admins can read all
      allow read: if isOwner(resource.data.userId) || isAdmin();

      // Users can self-enroll in free courses (enrollment ID must be uid_formationId)
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        enrollmentId == (request.auth.uid + '_' + request.resource.data.formationId);

      // Admins can create enrollments manually; payment webhook creates paid ones
      allow create: if isAdmin();

      // Users can update their own progress
      allow update: if isOwner(resource.data.userId) &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.formationId == resource.data.formationId;

      // Admins can update any enrollment (for manual enrollments, refunds, etc.)
      allow update: if isAdmin();

      // Only admins can delete enrollments
      allow delete: if isAdmin();
    }

    // Podcasts collection
    match /podcasts/{podcastId} {
      // Published podcasts are readable by all; drafts only by admins
      allow read: if resource.data.status == 'published' || isAdmin();

      // Only admins can create, update, or delete
      allow create, update, delete: if isAdmin();
    }

    // Videos collection
    match /videos/{videoId} {
      // Published videos are readable by all; drafts only by admins
      allow read: if resource.data.status == 'published' || isAdmin();

      // Only admins can create, update, or delete
      allow create, update, delete: if isAdmin();

      // Allow incrementing view count
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']) &&
        request.resource.data.views == resource.data.views + 1;
    }

    // Testimonials collection
    match /testimonials/{testimonialId} {
      // Everyone can read featured/approved testimonials; users can read their own; admins read all
      allow read: if resource.data.featured == true ||
        resource.data.status == 'approved' ||
        (isSignedIn() && resource.data.userId == request.auth.uid) ||
        isAdmin();

      // Students can submit a testimonial (status must be pending, userId must match)
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending';

      // Only admins can update or delete testimonials
      allow update, delete: if isAdmin();
    }

    // FAQ collection
    match /faq/{faqId} {
      // Everyone can read FAQs
      allow read: if true;

      // Only admins can manage FAQs
      allow create, update, delete: if isAdmin();
    }

    // Appointments collection
    match /appointments/{appointmentId} {
      // Anyone can book an appointment (public contact form) — with field validation
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'date', 'type'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 254
        && request.resource.data.date is string;

      // Admins and support can read and update appointments
      allow read, update: if isAdminOrSupport();

      // Only admins can delete
      allow delete: if isAdmin();
    }

    // Contact messages collection
    match /messages/{messageId} {
      // Users can read their own messages, admins and support can read all
      allow read: if isOwner(resource.data.userId) || isAdminOrSupport();

      // Anyone can create a contact message (even non-authenticated)
      // Validation : champs requis + tailles max pour limiter le spam
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'message'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 5000;

      // Only admins and support can update (to mark as read/replied)
      allow update: if isAdminOrSupport();

      // Only admins can delete
      allow delete: if isAdmin();
    }

    // Newsletter subscribers collection
    match /newsletter/{subscriberId} {
      // Only admins can read subscribers
      allow read: if isAdmin();

      // Anyone can subscribe — with field validation
      allow create: if request.resource.data.keys().hasAll(['email'])
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 254
        && request.resource.data.keys().size() <= 3;

      // Only admins can update or delete
      allow update, delete: if isAdmin();
    }

    // Transactions collection
    match /transactions/{transactionId} {
      // Users can read their own transactions, admins can read all
      allow read: if isOwner(resource.data.userId) || isAdmin();

      // Client-side creation restricted to free courses only
      // Paid transactions are created server-side by the createBictorysCharge Cloud Function
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'completed' &&
        request.resource.data.paymentMethod == 'free' &&
        request.resource.data.amount == 0;

      // Only admins can update (for refunds, status changes)
      allow update: if isAdmin();

      // Only admins can delete
      allow delete: if isAdmin();
    }

    // Coupons collection
    match /coupons/{couponId} {
      // Everyone can read active coupons to validate them
      allow read: if resource.data.active == true || isAdmin();

      // Only admins can manage coupons
      allow create, update, delete: if isAdmin();
    }

    // Announcements collection
    match /announcements/{announcementId} {
      // Everyone can read active announcements
      allow read: if resource.data.active == true || isAdmin();

      // Only admins can manage announcements
      allow create, update, delete: if isAdmin();
    }

    // Analytics collection (for storing analytics data)
    match /analytics/{docId} {
      // Only admins can read analytics
      allow read: if isAdmin();

      // Backend can write analytics
      allow create, update: if false;

      // Only admins can delete
      allow delete: if isAdmin();
    }

    // User activity logs (for admin dashboard)
    match /activity_logs/{logId} {
      // Only admins can read logs
      allow read: if isAdmin();

      // System can create logs
      allow create: if false;

      // Nobody can update or delete logs (immutable audit trail)
      allow update, delete: if false;
    }

    // Gamification profiles (XP, streaks, badges)
    match /gamification/{userId} {
      // Users can read their own profile; admins can read all (leaderboard needs signed-in read)
      allow read: if isSignedIn();

      // Users can create and update their own gamification profile
      allow create, update: if isOwner(userId);

      // Only admins can delete
      allow delete: if isAdmin();
    }

    // Certificates collection
    match /certificates/{certificateId} {
      // Users can read their own certificates
      allow read: if isOwner(resource.data.userId) || isAdmin();

      // Users can issue their own certificate if they completed the course (100% progress)
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        exists(/databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + request.resource.data.formationId)) &&
        get(/databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + request.resource.data.formationId)).data.progress == 100;

      // Nobody can update certificates (immutable)
      allow update: if false;

      // Only admins can delete (in case of fraud)
      allow delete: if isAdmin();
    }

    // User progress in lessons (subcollection under enrollments)
    match /enrollments/{enrollmentId}/progress/{lessonId} {
      // Users can read their own progress
      allow read: if isOwner(get(/databases/$(database)/documents/enrollments/$(enrollmentId)).data.userId) || isAdmin();

      // Users can update their own progress
      allow create, update: if isOwner(get(/databases/$(database)/documents/enrollments/$(enrollmentId)).data.userId);

      // Admins can manage progress
      allow create, update, delete: if isAdmin();
    }

    // Site settings (single document)
    match /settings/site {
      // Everyone can read site settings (for public info like site name, colors)
      allow read: if true;

      // Admins can create or update settings
      allow create, update: if isAdmin();

      // Cannot delete the settings document
      allow delete: if false;
    }

    // User notes (personal notes per student)
    match /users/{userId}/notes/{noteId} {
      allow read, create, update, delete: if isOwner(userId);
      allow read: if isAdmin();
    }

    // Notifications preferences (per user)
    match /users/{userId}/notifications/{notificationId} {
      // Users can read and manage their own notification preferences
      allow read, create, update, delete: if isOwner(userId);

      // Admins can read all
      allow read: if isAdmin();
    }

    // Club des Digitos — abonnements
    match /club_subscriptions/{userId} {
      // L'utilisateur peut lire son propre abonnement (StudentDashboard)
      allow read: if isOwner(userId) || isAdmin();

      // L'utilisateur ne peut créer qu'avec status 'pending' (pas d'auto-activation)
      allow create: if isOwner(userId) &&
        request.resource.data.status == 'pending';

      // L'utilisateur ne peut PAS changer le status lui-même
      allow update: if isOwner(userId) &&
        request.resource.data.status == resource.data.status;

      // L'admin peut tout créer/mettre à jour (activation manuelle, etc.)
      allow create, update: if isAdmin();

      // Seul l'admin peut supprimer
      allow delete: if isAdmin();
    }

    // Club des Digitos — posts du feed
    match /club_posts/{postId} {
      // Membres actifs et admins peuvent lire
      allow read: if hasActiveClubSub() || isAdmin();

      // Membres actifs peuvent créer leurs propres posts
      allow create: if (hasActiveClubSub() || isAdmin())
        && request.auth.uid == request.resource.data.userId;

      // L'auteur peut modifier son post (userId immuable) ; admin peut tout faire
      // Les membres peuvent mettre à jour uniquement les champs likes, reposts, commentsCount
      // commentsCount ne peut changer que de +1 ou -1
      allow update: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin()
        || ((hasActiveClubSub() || isAdmin()) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'reposts', 'commentsCount']) &&
            (request.resource.data.commentsCount == resource.data.commentsCount
             || request.resource.data.commentsCount == resource.data.commentsCount + 1
             || request.resource.data.commentsCount == resource.data.commentsCount - 1));

      // L'auteur ou l'admin peut supprimer
      allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();

      // Commentaires (sous-collection)
      match /comments/{commentId} {
        allow read: if hasActiveClubSub() || isAdmin();
        allow create: if (hasActiveClubSub() || isAdmin())
          && request.auth.uid == request.resource.data.userId;
        allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
        allow update: if false;
      }
    }

    // Club des Digitos — événements (lecture membres, écriture admin)
    match /club_events/{eventId} {
      allow read: if hasActiveClubSub() || isAdmin();
      allow create, update, delete: if isAdmin();

      // Inscriptions aux événements (sous-collection)
      match /registrations/{userId} {
        allow read, create, delete: if (hasActiveClubSub() || isAdmin()) && isOwner(userId);
        allow read: if isAdmin();
      }
    }

    // Club des Digitos — sessions live (lecture membres, écriture admin)
    match /club_sessions/{sessionId} {
      allow read: if hasActiveClubSub() || isAdmin();
      allow create, update, delete: if isAdmin();

      // Inscriptions aux sessions live (sous-collection)
      match /registrations/{userId} {
        allow read, create, delete: if (hasActiveClubSub() || isAdmin()) && isOwner(userId);
        allow read: if isAdmin();
      }
    }

    // Club des Digitos — infos exclusives (lecture membres, like membres, écriture admin)
    match /club_infos/{infoId} {
      allow read: if hasActiveClubSub() || isAdmin();
      // Les membres peuvent liker (mettre à jour uniquement le champ likes)
      allow update: if (hasActiveClubSub() || isAdmin()) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']);
      allow create, update, delete: if isAdmin();
    }

    // Notifications collection (per-user subcollection)
    match /notifications/{userId}/items/{notificationId} {
      // Users can read and update (mark as read) their own notifications
      allow read, update: if isOwner(userId);

      // Only backend/admin can create notifications
      allow create: if isAdmin();

      // Users can delete their own notifications
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Rate limiting collection (backend only — écrit uniquement par les Cloud Functions)
    match /_ratelimits/{docId} {
      allow read, write: if false;
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
