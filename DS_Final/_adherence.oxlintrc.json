        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute[name.name='name'] > Literal[value!=/^(?:back|forward|close|bell|search|lock|share|chat|home|book|users|user|star|check|alert|card|eye|download|trash|doc|send|bookmark|comment|dots|play|bars|heart|repeat|list|calendar|case|info|plus|chevron|globe)$/]",
        "message": "<Icon> name must be one of 'back' | 'forward' | 'close' | 'bell' | 'search' | 'lock' | 'share' | 'chat' | 'home' | 'book' | 'users' | 'user' | 'star' | 'check' | 'alert' | 'card' | 'eye' | 'download' | 'trash' | 'doc' | 'send' | 'bookmark' | 'comment' | 'dots' | 'play' | 'bars' | 'heart' | 'repeat' | 'list' | 'calendar' | 'case' | 'info' | 'plus' | 'chevron' | 'globe'."
      },
