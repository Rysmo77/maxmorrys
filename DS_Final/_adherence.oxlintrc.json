{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/brand/**",
              "components/data/**",
              "components/forms/**",
              "components/navigation/**",
              "components/surfaces/**",
              "design_handoff_maxmorrys/i18n/**",
              "design_handoff_maxmorrys/reference/**",
              "handoff_natif/**",
              "handoff_tableaux_de_bord/**",
              "ui_kits/**",
              "ui_kits/console/**",
              "ui_kits/native/**",
              "ui_kits/plateforme/**",
              "ui_kits/responsive/**",
              "ui_kits/site-public/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Fraunces|Schibsted Grotesk|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Fraunces, Schibsted Grotesk, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:initials|size|background|style|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: initials, size, background, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Breadcrumb'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|style|key|ref|className|style|children)$/]",
        "message": "<Breadcrumb> doesn't accept that prop. Declared props: items, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|size|fullWidth|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: tone, size, fullWidth, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|forme|informe|transforme|digitalise|ghost|quiet)$/]",
        "message": "<Button> tone must be one of 'primary' | 'forme' | 'informe' | 'transforme' | 'digitalise' | 'ghost' | 'quiet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<Button> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChatBubble'] > JSXAttribute > JSXIdentifier[name!=/^(?:from|typing|children|style|key|ref|className|style|children)$/]",
        "message": "<ChatBubble> doesn't accept that prop. Declared props: from, typing, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChatBubble'] > JSXAttribute[name.name='from'] > Literal[value!=/^(?:me|ai)$/]",
        "message": "<ChatBubble> from must be one of 'me' | 'ai'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CheckLine'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|dash|size|children|style|key|ref|className|style|children)$/]",
        "message": "<CheckLine> doesn't accept that prop. Declared props: tone, dash, size, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CheckLine'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:violet|ok|neutre)$/]",
        "message": "<CheckLine> tone must be one of 'violet' | 'ok' | 'neutre'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChipRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|height|layout|className|icon|style|key|ref|className|style|children)$/]",
        "message": "<ChipRow> doesn't accept that prop. Declared props: options, value, onChange, height, layout, className, icon, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChipRow'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:clip|scroll|wrap)$/]",
        "message": "<ChipRow> layout must be one of 'clip' | 'scroll' | 'wrap'."
