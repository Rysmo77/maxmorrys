{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maxmorrys-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-07-01",

  "workers_dev": false,
  "routes": [{ "pattern": "api.maxmorrys.me", "custom_domain": true }],

  "vars": {
    "FIREBASE_PROJECT_ID": "max-morrys",
    "ALLOWED_ORIGINS": "https://maxmorrys.me,https://www.maxmorrys.me,http://localhost:5173",

    // Callables servies localement. Tout nom absent est relayé vers Cloud
    // Functions : c'était l'interrupteur de bascule, et son rollback.
    //
    // ⚠️ CE RELAIS N'A PLUS DE CIBLE, ET TROIS NOMS Y TOMBAIENT ENCORE.
    //
    // Depuis le passage au plan Spark (13/08/2026, `billingEnabled: false`), il ne reste
    // AUCUNE Cloud Function : les v2 exigent Blaze. `FUNCTIONS_ORIGIN` répond donc 404 sur
    // tout. Un nom absent de cette liste n'est plus « relayé » — il est mort.
    //
    // `createBictorysCharge`, `createRysmoPackCharge`, `createRysmoSubscriptionCharge` et
    // `bictorysWebhook` étaient absents, alors que leurs gestionnaires existent et sont
    // enregistrés dans `registry.ts`, et alors que l'environnement `preview` ci-dessous les
    // déclare, lui. Relevé en production le 02/09/2026 :
    //
    //     popupEvent            → 200   (migré, sans authentification)
    //     getRysmoQuota         → 401   (migré, authentification requise)
    //     mediaToken            → 401   (migré, authentification requise)
    //     createBictorysCharge  → 404
    //     createRysmoPackCharge → 404
    //     bictorysWebhook       → 404
    //
    // Autrement dit : le Worker va bien, et TOUT LE CHEMIN DE L'ARGENT était injoignable —
    // aucune formation, aucun pack Rysmo, aucun abonnement Club ne pouvait être payé, et le
    // webhook de confirmation n'aurait de toute façon pas répondu.
    "MIGRATED": "acknowledgeAppointment,resendTransactionMail,getRysmoQuota,spotifyProxy,youtubeProxy,clearRysmoMemory,issueCertificate,adminCreateUser,creerMonProfil,adminManageRysmoQuota,adminManageEnrollment,translateContent,reindexSearch,parseCv,backfillSlugEn,weeklyClubDigestManual,rysmo,exportUserData,deleteUserAccount,mediaToken,popupEvent,createBictorysCharge,createRysmoPackCharge,createRysmoSubscriptionCharge,createClubCharge,bictorysWebhook,replyToMessage,notifyOnPublish,joinWaitlist,notifyWaitlist,quoteCheckout,importSpotifyEpisodesManual,syncMediaStatsManual,appMoi,appEspace,appCours,appCertificats,appClub,appNotes,appLecon,appClubFil,appMedia,appClubListe,appClubClassement,appConsole,appRepetiteur,signalerMembre,ecrireUneNote,marquerLecon,posterAuClub,reserverSession,appClubAgenda",

    "FUNCTIONS_ORIGIN": "https://us-central1-max-morrys.cloudfunctions.net",
    "BICTORYS_API_URL": "https://api.bictorys.com/pay/v1/charges",
    "APP_BASE_URL": "https://maxmorrys.me",
    "API_BASE_URL": "https://api.maxmorrys.me",
    "PUBLIC_MEDIA_BASE": "https://media.maxmorrys.me",

    // Remplacer par l'URL AI Gateway pour obtenir cache, budgets et traces.
    "GEMINI_BASE_URL": "https://generativelanguage.googleapis.com",

    // Sous-domaine d'envoi, activé par `wrangler email sending enable mail.maxmorrys.me`.
    // Jamais la racine : un incident de réputation transactionnelle n'entame alors pas la
    // délivrabilité de maxmorrys.me, d'où partent les échanges personnels.
    "EMAIL_FROM": "facture@mail.maxmorrys.me",
    "EMAIL_FROM_NAME": "Max-Morrys",
    /* ── Listmonk : le canal MARKETING ──────────────────────────────────────
       Distinct du transactionnel de bout en bout : autre fournisseur (Brevo en relais),
       autre sous-domaine d'envoi (`lettre.` et non `mail.`), autre réputation. Un incident
       sur l'un laisse l'autre intact — et Cloudflare Email Sending interdit de toute façon
       le marketing sur son propre canal.
       Le JETON est un secret : `npx wrangler secret put LISTMONK_API_TOKEN`. */
    "LISTMONK_URL": "https://listmonk.maxmorrys.me",
    "LISTMONK_API_USER": "API",
    "LISTMONK_LIST_ID": "3",


    // Vide tant que le régime fiscal de MY ONOMA SARL n'est pas confirmé par son comptable.
    // Une facture qui n'affirme rien sur la TVA se corrige ; une mention inventée se recopie
    // chez le client, qui la produit à son propre comptable.
    "INVOICE_TAX_NOTICE": ""
  },

  // Cloudflare Email Service. Le binding évite toute clé API à stocker — et donc à faire
  // fuir. Le domaine `from` doit être activé au préalable (`wrangler email sending list`).
  "send_email": [{ "name": "EMAIL" }],

  // Rappel d'échéance du Club, une fois par jour. La fenêtre de préavis est d'un jour
  // calendaire exactement : une exécution manquée n'est pas rattrapée le lendemain, parce
  // qu'un message « dans 15 jours » envoyé le quatorzième jour est faux.
  // Trois rendez-vous quotidiens. L'ordre est celui d'origine et il compte : la synchro
  // des statistiques passe AVANT l'import, pour ne pas mesurer des épisodes arrivés la
  // minute d'avant et n'ayant encore aucune écoute.
  //   03:00  syncMediaStats          vues YouTube + popularité Spotify
  //   04:00  importSpotifyEpisodes   nouveaux épisodes, en brouillon
  //   08:00  rappels d'échéance      fenêtre d'un jour calendaire, voir `estAEcheance`
  "triggers": { "crons": ["0 3 * * *", "0 4 * * *", "0 8 * * *"] },

  // Secrets :
  //   npx wrangler secret put GCP_SA_JSON < ../../../max-morrys-<id>.json
  //   npx wrangler secret put SPOTIFY_CLIENT_ID
  //   npx wrangler secret put SPOTIFY_CLIENT_SECRET
  //   npx wrangler secret put YOUTUBE_API_KEY

  "r2_buckets": [{ "binding": "EXPORTS", "bucket_name": "maxmorrys-lms" }],

  "observability": { "enabled": true },

  "env": {
    "preview": {
      "name": "maxmorrys-api-preview",
      "workers_dev": true,
      // ⚠️ Obligatoire : sans ce tableau vide, wrangler fait hériter la route
      // du niveau racine et l'environnement de preview prend le domaine réel.
      "routes": [],
      "vars": {
        "FIREBASE_PROJECT_ID": "max-morrys",
        "ALLOWED_ORIGINS": "https://maxmorrys.me,https://www.maxmorrys.me,http://localhost:5173",
        "MIGRATED": "acknowledgeAppointment,resendTransactionMail,getRysmoQuota,spotifyProxy,youtubeProxy,clearRysmoMemory,issueCertificate,adminCreateUser,creerMonProfil,adminManageRysmoQuota,adminManageEnrollment,translateContent,reindexSearch,parseCv,backfillSlugEn,weeklyClubDigestManual,rysmo,createBictorysCharge,createRysmoPackCharge,createRysmoSubscriptionCharge,createClubCharge,bictorysWebhook,exportUserData,deleteUserAccount,mediaToken,popupEvent,replyToMessage,notifyOnPublish,joinWaitlist,notifyWaitlist,quoteCheckout,importSpotifyEpisodesManual,syncMediaStatsManual,appMoi,appEspace,appCours,appCertificats,appClub,appNotes,appLecon,appClubFil,appMedia,appClubListe,appClubClassement,appConsole,appRepetiteur,signalerMembre,ecrireUneNote,marquerLecon,posterAuClub,reserverSession,appClubAgenda",
        "FUNCTIONS_ORIGIN": "https://us-central1-max-morrys.cloudfunctions.net",
    "BICTORYS_API_URL": "https://api.bictorys.com/pay/v1/charges",
    "APP_BASE_URL": "https://maxmorrys.me",
    // En preview, les liens d'export doivent pointer sur le worker de preview.
        "API_BASE_URL": "https://maxmorrys-api-preview.rysmo.workers.dev",
        "PUBLIC_MEDIA_BASE": "https://media.maxmorrys.me",
        "GEMINI_BASE_URL": "https://generativelanguage.googleapis.com",
        "EMAIL_FROM": "facture@mail.maxmorrys.me",
        "EMAIL_FROM_NAME": "Max-Morrys",
    /* ── Listmonk : le canal MARKETING ──────────────────────────────────────
       Distinct du transactionnel de bout en bout : autre fournisseur (Brevo en relais),
       autre sous-domaine d'envoi (`lettre.` et non `mail.`), autre réputation. Un incident
       sur l'un laisse l'autre intact — et Cloudflare Email Sending interdit de toute façon
       le marketing sur son propre canal.
       Le JETON est un secret : `npx wrangler secret put LISTMONK_API_TOKEN`. */
    "LISTMONK_URL": "https://listmonk.maxmorrys.me",
    "LISTMONK_API_USER": "API",
    "LISTMONK_LIST_ID": "3",

        "INVOICE_TAX_NOTICE": ""
      },
      "r2_buckets": [{ "binding": "EXPORTS", "bucket_name": "maxmorrys-lms" }],
      "send_email": [{ "name": "EMAIL" }],
      "observability": { "enabled": true }
    }
  }
}
