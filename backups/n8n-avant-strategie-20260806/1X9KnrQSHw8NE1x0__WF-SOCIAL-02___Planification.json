    {
      "parameters": {
        "jsCode": "// Aplatit la sortie NocoDB v3 {id, fields:{}} au format plat du noeud\n// Airtable historique : {...champs, id} -> aucune expression aval a changer.\nreturn $input.all().map(i => ({ json: { ...(i.json.fields || {}), id: i.json.id } }));"
      },
      "id": "at-s-airtable---lire-idéesf",
      "name": "Airtable — Lire idées",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        446,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Planifie jusqu'à 21 contenus (3 slots × 7 jours) avec répartition équilibrée par réseau.\n// Slots 9h / 13h / 18h UTC (= Dakar GMT+0). Préfère 1 post/réseau/jour mais accepte surplus si nécessaire.\n\nconst all = $input.all().map(i => i.json);\n// Tri par createdTime asc\nall.sort((a, b) => (a.createdTime || '').localeCompare(b.createdTime || ''));\n\nconst SLOTS = [9, 13, 18];\nconst DAYS = 7;\n\n// Helper pour extraire le réseau (fallback sur ancien schema)\nfunction getReseau(item) {\n  if (item.Reseau) return String(item.Reseau).toLowerCase();\n  if (item.Plateforme_Principale) {\n    const m = { facebook:'fb', instagram:'ig', tiktok:'tiktok', youtube:'youtube', linkedin:'linkedin', twitter:'x' };\n    return m[String(item.Plateforme_Principale).toLowerCase()] || 'linkedin';\n  }\n  if (Array.isArray(item.Reseaux_Cibles) && item.Reseaux_Cibles.length) {\n    return String(item.Reseaux_Cibles[0]).toLowerCase();\n  }\n  return 'linkedin';\n}\n\n// On prend tous les items (la limite vient du nombre de slots dispo)\nconst queue = all.slice();\n\n// Construire la grille 7j × 3 slots\nconst grid = [];\nfor (let d = 1; d <= DAYS; d++) {\n  for (const h of SLOTS) {\n    grid.push({ day: d, hour: h, reseaux: [] });\n  }\n}\nconst MAX = grid.length; // 21\n\nconst now = new Date();\nconst results = [];\nconst usedSlots = new Set();\n\nfor (const item of queue) {\n  if (results.length >= MAX) break;\n  const r = getReseau(item);\n\n  // Pass 1 : trouver un slot libre où ce réseau n'a PAS encore posté ce jour-là\n  let chosen = -1;\n  for (let i = 0; i < grid.length; i++) {\n    if (usedSlots.has(i)) continue;\n    // Vérifier si un autre slot du même jour a déjà ce réseau\n    const sameDayHasReseau = grid.some((g, gi) => g.day === grid[i].day && g.reseaux.includes(r));\n    if (!sameDayHasReseau) { chosen = i; break; }\n  }\n  // Pass 2 : n'importe quel slot libre (fallback si saturation mono-réseau)\n  if (chosen === -1) {\n    for (let i = 0; i < grid.length; i++) {\n      if (!usedSlots.has(i)) { chosen = i; break; }\n    }\n  }\n  if (chosen === -1) break; // grille pleine\n\n  usedSlots.add(chosen);\n  grid[chosen].reseaux.push(r);\n\n  const d = new Date(now);\n  d.setUTCDate(now.getUTCDate() + grid[chosen].day);\n  d.setUTCHours(grid[chosen].hour, 0, 0, 0);\n\n  results.push({ json: {\n    id: item.id,\n    Status: 'planifié',\n    Date_Publication_Prevue: d.toISOString()\n  }});\n}\n\nreturn results;\n"
      },
