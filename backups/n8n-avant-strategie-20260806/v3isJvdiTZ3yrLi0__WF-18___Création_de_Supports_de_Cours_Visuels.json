        },
        "messages": {
          "values": [
            {
              "content": "=Tu es un expert en design d'information pédagogique. Crée un diagramme clair pour une leçon de cours en ligne.\n\nSujet : {{ $json.prompt }}\nCours : {{ $json.course_title }}\nLeçon : {{ $json.lesson_title }}\n\nCrée le diagramme en code Mermaid.js.\nLe diagramme doit être compréhensible par un apprenant de niveau débutant/intermédiaire.\nUtilise des couleurs claires et un style professionnel.\n\nRéponse JSON :\n{ \"diagram_type\": \"flowchart|sequence|mindmap|timeline\", \"mermaid_code\": \"code mermaid complet\", \"title\": \"\", \"alt_text\": \"\" }"
            }
          ]
        },
        "options": {
          "maxOutputTokens": 8192,
          "temperature": 0.7,
          "thinkingBudget": 0
        },
        "jsonOutput": true
      },
      "id": "wf18-gemini-diagram",
      "name": "Gemini — Diagramme Mermaid",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.1,
      "position": [
        1200,
        100
