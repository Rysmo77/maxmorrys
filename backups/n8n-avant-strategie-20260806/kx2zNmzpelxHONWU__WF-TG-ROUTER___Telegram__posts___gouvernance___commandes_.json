    {
      "name": "PC — approuver/rejeter",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "jsCode": "\nconst j=$json;\nconst H={'CF-Access-Client-Id':j.cfId,'CF-Access-Client-Secret':j.cfSecret,'Content-Type':'application/json'};\ntry{\n  await this.helpers.httpRequest({method:'POST',url:`${j.pcBase}/api/approvals/${j.id}/${j.action==='approve'?'approve':'reject'}`,headers:H,body:{},json:true});\n}catch(e){ j.label='⚠️ Erreur: '+(e.message||e); }\nreturn [{json:j}];\n"
      },
      "id": "c9349082-b005-44ad-a8d7-0c6500293452"
    },
    {
      "name": "CMD — Paperclip",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        200
      ],
      "parameters": {
        "jsCode": "\nconst j=$json; const cmd=(j.cmd||'').split(/\\s+/)[0];\nconst H={'CF-Access-Client-Id':j.cfId,'CF-Access-Client-Secret':j.cfSecret};\nconst GET=(p)=>this.helpers.httpRequest({method:'GET',url:`${j.pcBase}${p}`,headers:H,json:true});\nconst POST=(p)=>this.helpers.httpRequest({method:'POST',url:`${j.pcBase}${p}`,headers:{...H,'Content-Type':'application/json'},body:{},json:true});\nlet reply='';\ntry{\n  if(cmd==='/pause'){const a=await GET(`/api/companies/${j.cid}/agents`);let n=0;for(const x of a){if(x.status!=='paused'){await POST(`/api/agents/${x.id}/pause`);n++;}}reply=`⛔ Kill-switch : ${n} agent(s) mis en pause (${a.length} au total).`;}\n  else if(cmd==='/resume'){const a=await GET(`/api/companies/${j.cid}/agents`);let n=0;for(const x of a){if(x.status==='paused'){await POST(`/api/agents/${x.id}/resume`);n++;}}reply=`▶️ ${n} agent(s) repris.`;}\n  else if(cmd==='/kpis'){const d=await GET(`/api/companies/${j.cid}/dashboard`);reply='📊 KPIs\\n```'+JSON.stringify(d).slice(0,900)+'```';}\n  else if(cmd==='/budget'){const c=await GET(`/api/companies/${j.cid}`);reply='💰 Budget : '+((c.spentMonthlyCents||0)/100)+' / '+((c.budgetMonthlyCents||0)/100)+' $/mois utilisés';}\n  else if(cmd==='/pending'){let ap=[];try{ap=await GET(`/api/companies/${j.cid}/approvals`);}catch(e){}const p=(ap||[]).filter(x=>x.status==='pending');reply=`⏳ Approbations Paperclip en attente : ${p.length}`;}\n  else reply='Commandes : /pending · /kpis · /budget · /pause · /resume';\n}catch(e){ reply='⚠️ Erreur Paperclip : '+(e.message||e)+'\\n(tunnel + CF Access configurés ?)'; }\nreturn [{json:{token:j.token,chatId:j.chatId,text:reply}}];\n"
      },
      "id": "28cc4e0f-c515-4934-af64-9e5a6965db6c"
    },
