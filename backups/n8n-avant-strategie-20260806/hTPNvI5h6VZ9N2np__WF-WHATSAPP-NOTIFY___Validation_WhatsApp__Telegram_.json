    {
      "name": "Build — Notif",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        40
      ],
      "parameters": {
        "jsCode": "const cfg={};for(const r of $('Airtable — Lire Config').all())if(r.json.Cle)cfg[r.json.Cle]=r.json.Valeur;\nconst token=cfg.TELEGRAM_BOT_TOKEN,chatId=cfg.TELEGRAM_CHAT_ID;const out=[];\nfor(const it of $('Airtable — WA à valider').all()){const w=it.json;\n  const text=`📱 *WhatsApp à valider*\\n\\n*Template :* ${w.TemplateName||'?'} (${w.TemplateLang||'en_US'})\\n*Vers :* ${w.To||'?'}\\n\\n${(w.Preview||'').slice(0,400)}`;\n  const reply_markup={inline_keyboard:[[{text:'✅ Approuver',callback_data:`approve:wa:${w.id}`},{text:'❌ Rejeter',callback_data:`reject:wa:${w.id}`}]]};\n  out.push({json:{recordId:w.id,token,body:{chat_id:chatId,text,parse_mode:'Markdown',reply_markup}}});}\nreturn out;\n"
      },
      "id": "2058ed51-19b5-4d95-8589-173ee833a756"
    },
