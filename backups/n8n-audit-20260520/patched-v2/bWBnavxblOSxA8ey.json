    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst mediaPrompts = input.media_prompts || [];\nconst courseTitle = input.course_title || '';\nconst lessonTitle = input.lesson_title || '';\n\nreturn mediaPrompts.map(mp => ({\n  json: {\n    type: mp.type || 'illustration',\n    prompt: mp.prompt || mp.description || '',\n    alt_text: mp.alt_text || '',\n    position: mp.position || '',\n    course_title: courseTitle,\n    lesson_title: lessonTitle\n  }\n}));"
      },
