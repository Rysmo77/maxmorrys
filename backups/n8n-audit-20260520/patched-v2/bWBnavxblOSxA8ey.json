        },
        "messages": {
          "values": [
            {
              "content": "=Tu es un expert en design d'information pédagogique. Crée un diagramme clair pour une leçon de cours en ligne.\n\nSujet : {{ $json.prompt }}\nCours : {{ $json.course_title }}\nLeçon : {{ $json.lesson_title }}\n\nCrée le diagramme en code Mermaid.js.\nLe diagramme doit être compréhensible par un apprenant de niveau débutant/intermédiaire.\nUtilise des couleurs claires et un style professionnel.\n\nRéponse JSON :\n{ \"diagram_type\": \"flowchart|sequence|mindmap|timeline\", \"mermaid_code\": \"code mermaid complet\", \"title\": \"\", \"alt_text\": \"\" }"
            }
          ]
        },
        "options": {
          "maxOutputTokens": 8192,
          "temperature": 0.7,
          "thinkingBudget": 0
        },
        "jsonOutput": true
      },
      "id": "wf18-gemini-diagram",
      "name": "Gemini — Diagramme Mermaid",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.1,
      "position": [
        1200,
        100
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "wQPLkug1dt6DGOt4",
          "name": "Google AI Max-Morrys LMS"
        }
      }
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "models/gemini-2.0-flash",
          "mode": "list",
          "cachedResultName": "models/gemini-2.0-flash"
        },
        "messages": {
          "values": [
            {
              "content": "=Tu es un designer d'infographies pédagogiques pour des cours en ligne.\nCrée la structure HTML/CSS d'une infographie pour la leçon.\nContenu : {{ $json.prompt }}\nStyle : professionnel, lisible sur mobile, max 800x600px.\nRéponse JSON : { \"html\": \"code HTML complet avec CSS inline\", \"title\": \"\", \"alt_text\": \"\" }"
            }
          ]
        },
        "options": {
          "maxOutputTokens": 16384,
          "temperature": 0.7,
          "thinkingBudget": 0
        },
        "jsonOutput": true
      },
      "id": "wf18-gemini-infographic",
      "name": "Gemini — Infographie HTML",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.1,
      "position": [
        1200,
        300
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "wQPLkug1dt6DGOt4",
          "name": "Google AI Max-Morrys LMS"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nlet result = { type: '', url: '', mermaid_code: '', html: '', alt_text: '' };\n\ntry {\n  if (input.candidates) {\n    // Gemini response (diagram or infographic)\n    const text = input.candidates?.[0]?.content?.parts?.[0]?.text || '{}';\n    const parsed = JSON.parse(text);\n    result.mermaid_code = parsed.mermaid_code || '';\n    result.html = parsed.html || '';\n    result.alt_text = parsed.alt_text || '';\n    result.type = result.mermaid_code ? 'diagram' : 'infographic';\n  } else if (input.file_url) {\n    // WF-15 response (illustration)\n    result.url = input.file_url;\n    result.type = 'illustration';\n    result.alt_text = input.original_prompt || '';\n  }\n} catch (e) {\n  // continue with empty result\n}\n\nreturn [{ json: result }];"
      },
