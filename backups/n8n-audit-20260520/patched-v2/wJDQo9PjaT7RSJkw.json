      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.1,
      "position": [
        208,
        0
      ],
      "id": "gemini-gemini-pro-—-proposer-idées",
      "name": "Gemini Pro — Proposer idées",
      "credentials": {
        "googlePalmApi": {
          "id": "wQPLkug1dt6DGOt4",
          "name": "Google AI Max-Morrys LMS"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// runOnceForAllItems — explode each idea into 1 row per (réseau, format)\nconst resp = $input.first().json;\nlet text = '';\nif (resp.candidates?.[0]?.content?.parts) text = resp.candidates[0].content.parts.map(p=>p.text||'').join('');\nelse if (typeof resp === 'string') text = resp;\nelse if (resp.content?.parts) text = resp.content.parts.map(p=>p.text||'').join('');\nelse text = JSON.stringify(resp);\n\nfunction extractJson(t) {\n  let c = (t||'').trim().replace(/^```(?:json)?\\s*/i,'').replace(/```\\s*$/i,'').trim();\n  try { return JSON.parse(c); } catch(e) {}\n  const m = c.match(/\\{[\\s\\S]*\\}/);\n  if (m) { try { return JSON.parse(m[0]); } catch(e) {} }\n  return null;\n}\n\nconst data = extractJson(text) || { ideas: [] };\nconst out = [];\nfor (const idea of (data.ideas || [])) {\n  const decls = Array.isArray(idea.declinaisons) && idea.declinaisons.length ? idea.declinaisons : [{ reseau: 'linkedin', format_post: 'post' }];\n  for (const d of decls) {\n    out.push({ json: {\n      Titre: (idea.titre || 'Sans titre').substring(0,120),\n      Thematique: idea.thematique || 'Autre',\n      Pilier: idea.pilier || 'Autre',\n      Format_Post: d.format_post || 'post',\n      Reseau: d.reseau || 'linkedin',\n      Brief: idea.brief || '',\n      Mots_Cles: idea.mots_cles || '',\n      Status: 'idée'\n    }});\n  }\n}\nreturn out.length ? out : [{ json: { _empty: true }}];\n"
      },
