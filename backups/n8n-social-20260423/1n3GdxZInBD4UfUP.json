        0,
        300
      ]
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "models/gemini-3-flash-preview",
          "mode": "list",
          "cachedResultName": "models/gemini-3-flash-preview"
        },
        "messages": {
          "values": [
            {
              "content": "=Tu es un designer de carrousels pour les réseaux sociaux, spécialisé dans le contenu pour l'Afrique de l'Ouest francophone.\n\nCrée un carrousel de 5-8 slides sur le sujet suivant :\nSUJET : {{ $json.Sujet }}\nRÉSEAU : {{ ($json.Reseau || 'instagram') }}\nCONTEXTE : Plateforme Max-Morrys, marketing digital, audience Sénégal/CI/Cameroun\n\nRÈGLES :\n- Slide 1 : hook accrocheur (question ou affirmation choc)\n- Slides 2-N : un point clé par slide, texte court, exemples locaux\n- Dernière slide : CTA clair (suivre le compte, visiter maxmorrys.me, s'inscrire)\n- Palette : couleurs de la marque Max-Morrys\n- Texte lisible sur mobile (gros caractères)\n- Emojis utilisés avec parcimonie\n\nPour chaque slide, donne aussi un prompt de génération d'image de fond.\n\nRÉPONSE JSON :\n{\n  \"carousel_title\": \"\",\n  \"total_slides\": 0,\n  \"slides\": [{\n    \"slide_number\": 1,\n    \"headline\": \"texte principal gros\",\n    \"body_text\": \"texte secondaire\",\n    \"background_prompt\": \"prompt pour générer le fond de la slide\",\n    \"layout\": \"centered|left|right|split\",\n    \"accent_color\": \"#hex\"\n  }],\n  \"caption\": \"caption pour accompagner le carrousel\",\n  \"hashtags\": []\n}"
            }
          ]
        },
        "jsonOutput": true,
        "builtInTools": {},
        "options": {
          "maxOutputTokens": 4096,
          "temperature": 0.7
        }
      },
      "id": "wf16-gemini",
      "name": "Gemini Flash — Concevoir le carrousel",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.1,
      "position": [
        304,
        304
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "wQPLkug1dt6DGOt4",
          "name": "Google AI Max-Morrys LMS"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst input = $('Airtable — Lire Calendrier carrousel').item.json;\n\nlet carousel;\ntry {\n  const text = response.candidates?.[0]?.content?.parts?.[0]?.text || '{}';\n  carousel = JSON.parse(text);\n} catch (e) {\n  throw new Error('Erreur parsing carrousel: ' + e.message);\n}\n\n// Output each slide as separate item for batch processing\nconst slides = (carousel.slides || []).map(slide => ({\n  ...slide,\n  carousel_title: carousel.carousel_title,\n  caption: carousel.caption,\n  hashtags: carousel.hashtags,\n  subject: (input.Sujet || input.subject || ''),\n  network: input.Reseau || input.network || 'instagram'\n}));\n\nreturn slides.map(s => ({ json: s }));"
      },
      "id": "wf16-parse",
      "name": "Parse — Extraire les slides",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        608,
        304
      ]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "wf16-batch",
      "name": "Batch — Par slide",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        912,
        304
      ]
    },
    {
      "parameters": {
        "jsCode": "const allSlides = $('Batch — Par slide').all();\nconst imageResults = $input.all();\n\nconst result = allSlides.map((slide, i) => ({\n  slide_number: slide.json.slide_number,\n  headline: slide.json.headline,\n  body_text: slide.json.body_text,\n  image_url: imageResults[i]?.json?.file_url || '',\n  layout: slide.json.layout\n}));\n\nconst firstSlide = allSlides[0]?.json || {};\n\nreturn [{\n  json: {\n    carousel_title: firstSlide.carousel_title,\n    slides: result,\n    caption: firstSlide.caption,\n    hashtags: firstSlide.hashtags,\n    subject: firstSlide.subject,\n    network: firstSlide.network,\n    generated_at: new Date().toISOString()\n  }\n}];"
      },
      "id": "wf16-assemble",
      "name": "Assembler — Carrousel final",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1504,
        304
      ]
    },
    {
      "id": "wf16-sheets",
      "name": "Airtable — Log carrousel",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
