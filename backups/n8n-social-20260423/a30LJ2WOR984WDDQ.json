      },
      "id": "cron-trigger",
      "name": "Cron — Commentaires 16h quotidien",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst body = input.body || input;\n\nreturn [{\n  json: {\n    network: body.network || 'facebook',\n    post_id: body.post_id || '',\n    comment_id: body.comment_id || '',\n    comment_text: body.comment_text || body.message || '',\n    author_name: body.author_name || body.from?.name || '',\n    author_id: body.author_id || body.from?.id || '',\n    post_subject: body.post_subject || '',\n    received_at: new Date().toISOString()\n  }\n}];"
      },
      "id": "wf05-normalize",
      "name": "Normaliser — Commentaire",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        300,
        300
      ]
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "models/gemini-2.0-flash",
          "mode": "list",
          "cachedResultName": "models/gemini-2.0-flash"
        },
        "messages": {
          "values": [
            {
              "content": "=Tu es le Community Manager de Max-Morrys. Tu réponds aux commentaires sur les réseaux sociaux.\n\nRÈGLES :\n- Tu réponds dans le style conversationnel d'Afrique de l'Ouest\n- Tu comprends les expressions locales courantes (wolof, nouchi, camfranglais)\n- Ton bienveillant, pédagogue, tutoyant\n- Si le commentaire est négatif : rester professionnel, empathique, proposer de l'aide\n- Si le commentaire est positif : remercier chaleureusement, encourager\n- Si c'est une question : répondre avec expertise, rediriger vers maxmorrys.me si pertinent\n- Max 200 caractères pour Twitter, 500 pour les autres réseaux\n- JAMAIS de réponse générique type \"Merci pour votre commentaire\"\n\nRÉSEAU : {{ $json.network }}\nSUJET DU POST : {{ $json.post_subject }}\nCOMMENTAIRE DE {{ $json.author_name }} : \"{{ $json.comment_text }}\"\n\nRéponse JSON :\n{\n  \"sentiment\": \"positif|négatif|neutre|question\",\n  \"response\": \"réponse proposée\",\n  \"needs_human_review\": false,\n  \"reason_for_review\": \"\",\n  \"suggested_action\": \"reply|like_only|ignore|escalate\"\n}"
            }
          ]
        },
        "options": {
          "maxOutputTokens": 4096,
          "temperature": 0.7
        },
        "jsonOutput": true
      },
      "id": "wf05-gemini",
      "name": "Gemini Flash — Analyser & Répondre",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.1,
      "position": [
        600,
        300
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "wQPLkug1dt6DGOt4",
          "name": "Google AI Max-Morrys LMS"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst comment = $('Normaliser — Commentaire').first().json;\n\nlet parsed;\ntry {\n  const text = response.candidates?.[0]?.content?.parts?.[0]?.text || '{}';\n  parsed = JSON.parse(text);\n} catch (e) {\n  parsed = { sentiment: 'neutre', response: '', needs_human_review: true, suggested_action: 'escalate' };\n}\n\nreturn [{\n  json: {\n    ...comment,\n    sentiment: parsed.sentiment,\n    suggested_response: parsed.response,\n    needs_human_review: parsed.needs_human_review,\n    reason_for_review: parsed.reason_for_review || '',\n    suggested_action: parsed.suggested_action\n  }\n}];"
      },
      "id": "wf05-parse",
      "name": "Parse — Réponse analysée",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.needs_human_review }}",
              "value2": true
            }
          ]
        }
      },
      "id": "wf05-needs-review",
      "name": "IF — Review humain ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1200,
        300
      ]
    },
    {
      "parameters": {
        "chatId": "934156307",
        "text": "=💬 *Commentaire à traiter* — {{ $('Parse — Réponse analysée').first().json.network }} ({{ $('Parse — Réponse analysée').first().json.sentiment }})\n\n*De :* {{ $('Parse — Réponse analysée').first().json.author_name }}\n> {{ $('Parse — Réponse analysée').first().json.comment_text }}\n\n*Réponse suggérée :*\n_{{ $('Parse — Réponse analysée').first().json.suggested_response }}_\n\n*Raison :* {{ $('Parse — Réponse analysée').first().json.reason_for_review }}",
        "additionalFields": {
