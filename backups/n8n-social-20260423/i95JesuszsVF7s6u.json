      ]
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "models/gemini-2.0-flash",
          "mode": "list",
          "cachedResultName": "models/gemini-2.0-flash"
        },
        "messages": {
          "values": [
            {
              "content": "=Tu es un analyste social media expert pour Max-Morrys (marketing digital, Afrique de l'Ouest).\n\nAnalyse les données de la semaine et génère un rapport avec des recommandations actionnables.\n\nPÉRIODE : {{ $json.period }}\nSTATISTIQUES : {{ JSON.stringify($json.stats) }}\n\nRéponse JSON :\n{\n  \"summary\": \"résumé en 3 phrases\",\n  \"score_global\": 0,\n  \"highlights\": [\"point positif 1\", \"point positif 2\"],\n  \"improvements\": [\"amélioration 1\", \"amélioration 2\"],\n  \"recommendations\": [{\n    \"action\": \"action concrète\",\n    \"priority\": \"haute|moyenne|basse\",\n    \"expected_impact\": \"\"\n  }],\n  \"content_insights\": {\n    \"best_format\": \"\",\n    \"best_network\": \"\",\n    \"best_time\": \"\",\n    \"topic_to_explore\": \"\"\n  }\n}"
            }
          ]
        },
        "options": {
          "maxOutputTokens": 4096,
          "temperature": 0.7
        },
        "jsonOutput": true
      },
      "id": "wf06-gemini",
      "name": "Gemini Flash — Analyser & Recommander",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.1,
      "position": [
        900,
        300
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "wQPLkug1dt6DGOt4",
          "name": "Google AI Max-Morrys LMS"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst stats = $('Compile — Statistiques').first().json;\n\nlet report;\ntry {\n  const text = response.candidates?.[0]?.content?.parts?.[0]?.text || '{}';\n  report = JSON.parse(text);\n} catch (e) {\n  report = { summary: 'Erreur génération du rapport', score_global: 0, highlights: [], improvements: [], recommendations: [] };\n}\n\nconst weekNum = Math.ceil((new Date().getTime() - new Date(new Date().getFullYear(), 0, 1).getTime()) / (7 * 86400000));\n\nreturn [{\n  json: {\n    Semaine: `S${weekNum}`,\n    Score: report.score_global,\n    Reach: stats.stats.total_posts_published,\n    Engagement: stats.stats.total_interactions,\n    Top_Posts: (report.highlights || []).join(' | '),\n    Recommandations: (report.recommendations || []).map(r => r.action).join(' | '),\n    report_full: report,\n    period: stats.period\n  }\n}];"
      },
