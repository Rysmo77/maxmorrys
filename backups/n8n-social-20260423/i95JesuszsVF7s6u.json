    {
      "parameters": {
        "jsCode": "const calendar = $('Airtable — Calendrier').all().map(i => i.json);\nconst interactions = $('Airtable — Interactions').all().map(i => i.json);\n\n// Filter to last 7 days\nconst weekAgo = new Date(Date.now() - 7 * 86400000).toISOString().split('T')[0];\nconst weekPosts = calendar.filter(c => c.Date >= weekAgo);\nconst weekInteractions = interactions.filter(i => i.Date >= weekAgo);\n\nconst stats = {\n  total_posts_planned: weekPosts.length,\n  total_posts_published: weekPosts.filter(p => p.Status_Publication === 'publié').length,\n  total_interactions: weekInteractions.length,\n  sentiment_breakdown: {\n    positif: weekInteractions.filter(i => i.Sentiment === 'positif').length,\n    negatif: weekInteractions.filter(i => i.Sentiment === 'négatif').length,\n    neutre: weekInteractions.filter(i => i.Sentiment === 'neutre').length,\n    question: weekInteractions.filter(i => i.Sentiment === 'question').length\n  },\n  networks_breakdown: {},\n  posts_by_status: {\n    published: weekPosts.filter(p => p.Status_Publication === 'publié').length,\n    pending: weekPosts.filter(p => p.Status_Publication === 'planifié').length,\n    produced: weekPosts.filter(p => p.Status_Contenu === 'produit').length\n  }\n};\n\n// Count by network\nfor (const p of weekPosts) {\n  const net = p.Reseau || 'unknown';\n  stats.networks_breakdown[net] = (stats.networks_breakdown[net] || 0) + 1;\n}\n\nreturn [{ json: { stats, week_posts: weekPosts, week_interactions: weekInteractions, period: `${weekAgo} — ${new Date().toISOString().split('T')[0]}` } }];"
      },
