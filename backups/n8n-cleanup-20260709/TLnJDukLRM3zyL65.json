     "name": "Airtable Max-Morrys"
    }
   }
  },
  {
   "parameters": {
    "jsCode": "// runOnceForAllItems — 1 row with Blotato_PostSubmissionID non résolu → 1 item à tracker\nconst posts = $input.all().map(i => i.json);\nconst results = [];\nfor (const post of posts) {\n  if (!post.Blotato_PostSubmissionID) continue;\n  if (post.Blotato_PublicUrl) continue; // already resolved\n  results.push({ json: { recordId: post.id, postSubmissionId: post.Blotato_PostSubmissionID }});\n}\nreturn results.length ? results : [{ json: { _empty: true }}];\n"
   },
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    500,
    0
   ],
   "id": "code-extract---unresolved-subs",
   "name": "Extract — Unresolved subs"
  },
  {
   "parameters": {
    "method": "GET",
    "url": "=https://backend.blotato.com/v2/posts/{{ $json.postSubmissionId }}",
    "authentication": "predefinedCredentialType",
    "nodeCredentialType": "httpHeaderAuth",
    "options": {}
   },
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    750,
    0
   ],
   "id": "http-blotato---get-/v2/posts/{id}",
   "name": "Blotato — GET /v2/posts/{id}",
   "credentials": {
    "httpHeaderAuth": {
     "id": "LUdzToALNXHeRdgj",
     "name": "Blotato API"
    }
   }
  },
  {
   "parameters": {
    "jsCode": "// runOnceForEachItem — un Blotato response → update direct\nconst resp = $input.item.json;\nconst src = $('Extract — Unresolved subs').all()[$itemIndex].json;\nif (src._empty) return { json: { _skip: true }};\nconst status = resp.status || '';\nconst publicUrl = resp.publicUrl || '';\nconst errorMessage = resp.errorMessage || '';\n\nlet finalStatus = 'en_publication';\nif (status === 'published') finalStatus = 'publié';\nelse if (status === 'failed') finalStatus = 'échec';\n\nreturn { json: {\n  id: src.recordId,\n  Blotato_PublicUrl: (status === 'published' ? publicUrl : ''),\n  Status: finalStatus,\n  Erreurs: (status === 'failed' ? errorMessage : '')\n}};\n",
    "mode": "runOnceForEachItem"
   },
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1000,
    0
   ],
