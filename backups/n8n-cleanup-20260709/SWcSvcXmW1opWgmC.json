    "messages": {
     "values": [
      {
       "content": "=Tu es un créateur de contenu vidéo court (Reels/Shorts/TikTok) expert pour l'Afrique de l'Ouest francophone.\n\nCrée un storyboard complet pour une vidéo courte (30-60 secondes) sur :\nSUJET : {{ $json.Sujet }}\nPLATEFORME : {{ ($json.Reseau || 'instagram_reels') }}\nCONTEXTE : Max-Morrys, marketing digital, audience Sénégal/CI/Cameroun\n\nRÈGLES :\n- Hook dans les 3 premières secondes (question choc ou affirmation surprenante)\n- Format vertical 9:16 (1080x1920)\n- Rythme rapide, changements de plan fréquents\n- Texte superposé lisible sur mobile\n- Musique/son tendance suggéré\n- CTA final (suivre, commenter, partager, lien en bio)\n- Exemples et références locales (Dakar, Abidjan, etc.)\n\nRÉPONSE JSON :\n{\n  \"title\": \"titre du reel\",\n  \"duration_seconds\": 30,\n  \"hook\": \"les 3 premières secondes — texte ou action\",\n  \"scenes\": [{\n    \"scene_number\": 1,\n    \"duration_seconds\": 3,\n    \"visual\": \"description de ce qu'on voit\",\n    \"text_overlay\": \"texte affiché à l'écran\",\n    \"voiceover\": \"texte narratif\",\n    \"transition\": \"cut|zoom|slide|fade\",\n    \"thumbnail_prompt\": \"prompt pour générer une image de cette scène\"\n  }],\n  \"caption\": \"caption pour accompagner la vidéo\",\n  \"hashtags\": [],\n  \"suggested_audio\": \"type de musique ou son tendance\",\n  \"thumbnail_prompt\": \"prompt pour la miniature de la vidéo\",\n  \"cta\": \"appel à l'action final\"\n}"
      }
     ]
    },
    "jsonOutput": true,
    "builtInTools": {},
    "options": {
     "maxOutputTokens": 4096,
     "temperature": 0.7
    }
   },
