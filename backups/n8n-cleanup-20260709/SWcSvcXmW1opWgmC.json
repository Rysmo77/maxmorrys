   "parameters": {
    "jsCode": "const response = $input.first().json;\nconst input = $('Airtable — Lire Calendrier reel').item.json;\n\nlet storyboard;\ntry {\n  const text = response.candidates?.[0]?.content?.parts?.[0]?.text || '{}';\n  storyboard = JSON.parse(text);\n} catch (e) {\n  throw new Error('Erreur parsing storyboard: ' + e.message);\n}\n\nreturn [{\n  json: {\n    ...storyboard,\n    subject: (input.Sujet || input.subject || ''),\n    platform: input.Reseau || input.platform || 'instagram_reels',\n    generated_at: new Date().toISOString()\n  }\n}];"
