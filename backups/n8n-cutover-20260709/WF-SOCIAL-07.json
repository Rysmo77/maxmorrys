    {
      "name": "Build — Payload Telegram",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        540,
        40
      ],
      "parameters": {
        "jsCode": "\nconst cfg = {};\nfor (const r of $('Airtable — Lire Config').all()) { if (r.json.Cle) cfg[r.json.Cle] = r.json.Valeur; }\nconst token = cfg.TELEGRAM_BOT_TOKEN, chatId = cfg.TELEGRAM_CHAT_ID;\nconst out = [];\nfor (const it of $('Airtable — Lire à valider').all()) {\n  const p = it.json;\n  let media = []; try { media = JSON.parse(p.Visuels_URLs || '[]'); } catch(e) {}\n  const photo = media[0];\n  const cap = `🆕 *Post à valider* — ${p.Reseau||'?'}\\n\\n*${(p.Titre||'').replace(/[*_`]/g,'')}*\\n\\n${(p.Texte||'').slice(0,650)}\\n\\n_Pilier: ${p.Pilier||'-'} · ${p.Format_Post||''}_`;\n  const reply_markup = { inline_keyboard: [[\n    { text: '✅ Approuver', callback_data: `approve:post:${p.id}` },\n    { text: '❌ Rejeter',  callback_data: `reject:post:${p.id}` }\n  ]]};\n  const method = photo ? 'sendPhoto' : 'sendMessage';\n  const body = photo\n    ? { chat_id: chatId, photo, caption: cap, parse_mode: 'Markdown', reply_markup }\n    : { chat_id: chatId, text: cap, parse_mode: 'Markdown', reply_markup };\n  out.push({ json: { recordId: p.id, token, method, body } });\n}\nreturn out;\n"
      },
      "id": "fa9be195-3832-4106-971e-1ec87e6b3614"
    },
    {
      "name": "HTTP — Envoi Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        820,
        40
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $json.token }}/{{ $json.method }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {}
      },
      "id": "556fb885-cb66-4af3-ba7d-2039e1ac04be",
      "continueOnFail": true
    },
