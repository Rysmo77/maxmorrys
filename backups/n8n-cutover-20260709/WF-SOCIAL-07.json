    {
      "id": "pair-notif-01",
      "name": "Pair notif",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1050,
        500
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const rec = $('Build — Payload Telegram').all()[$itemIndex].json.recordId;\nconst r = $input.item.json;\nconst mid = (r && r.result && r.result.message_id) ? r.result.message_id : '';\nreturn { json: { recordId: rec, message_id: mid ? String(mid) : 'notified' } };"
      }
    }
