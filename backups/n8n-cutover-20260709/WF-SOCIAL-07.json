    {
      "name": "Airtable — Lire à valider",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [
        260,
        -60
      ],
      "parameters": {
        "resource": "record",
        "operation": "search",
        "base": {
          "__rl": true,
          "value": "apppkEbepilHCYiso",
          "mode": "list"
        },
        "table": {
          "__rl": true,
          "value": "tblPYoyzcZLdtBTO3",
          "mode": "list"
        },
        "returnAll": true,
        "options": {},
        "filterByFormula": "AND({Status}='prêt_à_valider',{Blotato_PostSubmissionID}='')"
      },
      "credentials": {
        "airtableTokenApi": {
          "id": "ik5KqgcooeDvHpFb",
