    {
      "name": "Build — Notif",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        40
      ],
      "parameters": {
        "jsCode": "const cfg={};for(const r of $('Airtable — Lire Config').all())if(r.json.Cle)cfg[r.json.Cle]=r.json.Valeur;\nconst token=cfg.TELEGRAM_BOT_TOKEN,chatId=cfg.TELEGRAM_CHAT_ID;\nconst out=[];\nfor(const it of $('Airtable — Emails à valider').all()){\n  const e=it.json;\n  const text=`📧 *Email à valider*\\n\\n*Objet :* ${e.Subject||'(sans objet)'}\\n\\n${(e.Preview||'').slice(0,500)}\\n\\n_Liste : ${e.ListId||cfg.BREVO_LIST_ID}_`;\n  const reply_markup={inline_keyboard:[[{text:'✅ Approuver',callback_data:`approve:email:${e.id}`},{text:'❌ Rejeter',callback_data:`reject:email:${e.id}`}]]};\n  out.push({json:{recordId:e.id,token,body:{chat_id:chatId,text,parse_mode:'Markdown',reply_markup}}});\n}\nreturn out;\n"
      },
      "id": "1fc1f496-010c-4664-b7e6-587e7bf63d7d"
    },
