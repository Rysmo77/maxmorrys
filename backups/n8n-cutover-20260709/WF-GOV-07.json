      "name": "GET approbations Paperclip",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "jsCode": "const cfg={};for(const r of $('Airtable — Lire Config').all())if(r.json.Cle)cfg[r.json.Cle]=r.json.Valeur;\nconst H={'CF-Access-Client-Id':cfg.CF_ACCESS_CLIENT_ID,'CF-Access-Client-Secret':cfg.CF_ACCESS_CLIENT_SECRET};\nlet ap=[]; try{ ap=await this.helpers.httpRequest({method:'GET',url:`${cfg.PAPERCLIP_BASE}/api/companies/${cfg.PAPERCLIP_COMPANY_ID}/approvals`,headers:H,json:true}); }catch(e){ return []; }\nconst sd=$getWorkflowStaticData('global'); sd.seen=sd.seen||{};\nconst out=[];\nfor(const a of (ap||[]).filter(x=>x.status==='pending')){\n  if(sd.seen[a.id]) continue; sd.seen[a.id]=true;\n  const p=a.payload||{}; const desc=p.title||p.name||(typeof p==='object'?JSON.stringify(p).slice(0,400):String(p));\n  const text=`🛡️ *Approbation requise* — ${a.type}\\n\\n${desc}`;\n  const reply_markup={inline_keyboard:[[{text:'✅ Approuver',callback_data:`approve:pc:${a.id}`},{text:'❌ Rejeter',callback_data:`reject:pc:${a.id}`}]]};\n  out.push({json:{token:cfg.TELEGRAM_BOT_TOKEN,body:{chat_id:cfg.TELEGRAM_CHAT_ID,text,parse_mode:'Markdown',reply_markup}}});\n}\nreturn out;\n"
      },
      "id": "485f9509-bd16-48f8-b22e-6c5836f587d7"
    },
