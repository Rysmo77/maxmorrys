    {
      "name": "Digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        0
      ],
      "parameters": {
        "jsCode": "const cfg={};for(const r of $('Airtable — Lire Config').all())if(r.json.Cle)cfg[r.json.Cle]=r.json.Valeur;\nconst H={'CF-Access-Client-Id':cfg.CF_ACCESS_CLIENT_ID,'CF-Access-Client-Secret':cfg.CF_ACCESS_CLIENT_SECRET};\nconst postsAValider=$('Airtable — Posts à valider').all().length;\nlet kpi='(indispo)',bud='(indispo)',appro='?';\ntry{ const d=await this.helpers.httpRequest({method:'GET',url:`${cfg.PAPERCLIP_BASE}/api/companies/${cfg.PAPERCLIP_COMPANY_ID}/dashboard`,headers:H,json:true}); kpi=JSON.stringify(d).slice(0,400); }catch(e){}\ntry{ const c=await this.helpers.httpRequest({method:'GET',url:`${cfg.PAPERCLIP_BASE}/api/companies/${cfg.PAPERCLIP_COMPANY_ID}`,headers:H,json:true}); bud=((c.spentMonthlyCents||0)/100)+'$ / '+((c.budgetMonthlyCents||0)/100)+'$'; }catch(e){}\ntry{ const ap=await this.helpers.httpRequest({method:'GET',url:`${cfg.PAPERCLIP_BASE}/api/companies/${cfg.PAPERCLIP_COMPANY_ID}/approvals`,headers:H,json:true}); appro=(ap||[]).filter(x=>x.status==='pending').length; }catch(e){}\nconst text=`🌅 *Digest Maxmorrys Social*\\n\\n📝 Posts à valider : *${postsAValider}*\\n🛡️ Approbations Paperclip : *${appro}*\\n📊 KPIs : \\`${kpi}\\`\\n💰 Budget : \\`${bud}\\``;\nreturn [{json:{token:cfg.TELEGRAM_BOT_TOKEN,body:{chat_id:cfg.TELEGRAM_CHAT_ID,text,parse_mode:'Markdown'}}}];\n"
      },
      "id": "ec47a8b7-bca8-4329-a24f-43b977b8a655"
    },
