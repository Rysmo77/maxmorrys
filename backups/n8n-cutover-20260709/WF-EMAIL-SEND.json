    {
      "name": "Build — Campagne Brevo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        20
      ],
      "parameters": {
        "jsCode": "const cfg={};for(const r of $('Airtable — Lire Config').all())if(r.json.Cle)cfg[r.json.Cle]=r.json.Valeur;\nconst out=[];\nfor(const it of $('Airtable — Emails validés').all()){\n  const e=it.json;\n  const body={name:(e.Subject||'Campagne')+' '+e.id, subject:e.Subject||'Max-Morrys',\n    sender:{name:cfg.BREVO_SENDER_NAME||'Max-Morrys',email:cfg.BREVO_SENDER_EMAIL},\n    htmlContent:e.HTML||('<p>'+(e.Preview||'')+'</p>'),\n    recipients:{listIds:[parseInt(e.ListId||cfg.BREVO_LIST_ID||'2',10)]}};\n  out.push({json:{recordId:e.id, body}});\n}\nreturn out;\n"
      },
      "id": "b4b8f5ba-bf47-401d-a1c1-b90ce209193b"
    },
