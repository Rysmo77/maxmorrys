    {
      "name": "Build — Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        20
      ],
      "parameters": {
        "jsCode": "const cfg={};for(const r of $('Airtable — Lire Config').all())if(r.json.Cle)cfg[r.json.Cle]=r.json.Valeur;\nconst token=cfg.WHATSAPP_TOKEN,phone=cfg.PHONE_NUMBER_ID;const out=[];\nfor(const it of $('Airtable — WA validés').all()){const w=it.json;\n  const body={messaging_product:'whatsapp',to:String(w.To||'').replace(/[^0-9]/g,''),type:'template',\n    template:{name:w.TemplateName,language:{code:w.TemplateLang||'en_US'}}};\n  out.push({json:{recordId:w.id,token,phone,body}});}\nreturn out;\n"
      },
      "id": "51bc68b7-af8c-4d9d-80e8-c73f0fae4f9e"
    },
    {
      "name": "WhatsApp — Envoyer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        800,
        20
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $json.phone }}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.token }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {}
      },
      "id": "e5536dc2-e03e-4590-a9a8-e4bf5a4c2a56"
