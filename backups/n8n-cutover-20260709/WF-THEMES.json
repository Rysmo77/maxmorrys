    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst cfg={};for(const r of $('THEMES — Lire Config').all())if(r.json.Cle)cfg[r.json.Cle]=r.json.Valeur;\nlet g=$input.first().json;\nif(g&&g.content!==undefined)g=g.content;\nif(g&&g.text!==undefined)g=g.text;\nif(typeof g==='string'){try{g=JSON.parse(g);}catch(e){g={};}}\nlet themes=(g&&(g.themes||g.Themes))||[];\nif(!Array.isArray(themes))themes=[];\nthemes=themes.slice(0,4);\nif(!themes.length)themes=[{titre:'Marque & IA',angle:'',pourquoi:''}];\nconst lines=themes.map((t,i)=>`<b>${i+1}. ${t.titre}</b>\\n${t.angle||''}\\n<i>${t.pourquoi||''}</i>`).join('\\n\\n');\nconst text=`🗓️ <b>CMO Aïcha — thèmes proposés (semaine prochaine)</b>\\n\\n${lines}\\n\\n👉 Choisis-en un ci-dessous : je le décline en 10 posts prêts à valider.`;\nconst kb={inline_keyboard:themes.map((t,i)=>[{text:`${i+1}. ${String(t.titre).slice(0,32)}`,callback_data:`pick:theme:${i}`}])};\nconst tgBody={chat_id:cfg.TELEGRAM_CHAT_ID,text,parse_mode:'HTML',reply_markup:kb};\nreturn [{json:{token:cfg.TELEGRAM_BOT_TOKEN,themesJson:JSON.stringify(themes),tgBody}}];\n"
      },
