# Firebase Configuration
# Obtenez ces valeurs depuis Firebase Console > Project Settings > General > Your apps

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# Monitoring des erreurs (optionnel)
# Compatible Sentry SaaS OU GlitchTip auto-hébergé (drop-in : le SDK est identique,
# seul le DSN change). Laisser vide pour désactiver complètement.
VITE_SENTRY_DSN=

# Recherche Meilisearch (optionnel — additif, inactif tant que vide)
# Renseigner UNIQUEMENT la clé "search-only" (publique) ici, jamais la clé admin/master.
VITE_MEILISEARCH_HOST=
VITE_MEILISEARCH_SEARCH_KEY=
# Côté serveur (indexation), les secrets se définissent via la CLI Firebase, pas ici :
#   firebase functions:secrets:set MEILISEARCH_HOST
#   firebase functions:secrets:set MEILISEARCH_ADMIN_KEY

# Important : Ne commitez JAMAIS votre fichier .env avec des vraies valeurs !
# Le fichier .env est déjà dans .gitignore
