# Firebase Configuration
# Obtenez ces valeurs depuis Firebase Console > Project Settings > General > Your apps

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# Upload des médias via Cloudflare R2 (Worker media-api)
# URL du Worker d'upload. Laisser tel quel en prod (https://media-api.maxmorrys.me).
VITE_MEDIA_API_URL=https://media-api.maxmorrys.me

# Origine des callables. Vide = Cloud Functions us-central1 (comportement historique).
# Renseigner https://api.maxmorrys.me pour router les callables via le Worker
# Cloudflare, qui relaie lui-même vers Cloud Functions tout ce qui n'est pas
# encore migré (variable MIGRATED du Worker). Rollback = revider cette variable.
VITE_FUNCTIONS_ORIGIN=

# Monitoring des erreurs (optionnel)
# Compatible Sentry SaaS OU GlitchTip auto-hébergé (drop-in : le SDK est identique,
# seul le DSN change). Laisser vide pour désactiver complètement.
VITE_SENTRY_DSN=

# Recherche Typesense (optionnel — additif, inactif tant que vide)
# Renseigner UNIQUEMENT la clé "search-only" (scopée) ici, jamais la clé admin/master.
# Instance auto-hébergée sur le VPS : voir docs/typesense-vps.md
VITE_TYPESENSE_HOST=typesense.maxmorrys.me
VITE_TYPESENSE_SEARCH_KEY=
VITE_TYPESENSE_PROTOCOL=https
VITE_TYPESENSE_PORT=443
# Côté serveur (indexation), les secrets se définissent via la CLI Firebase, pas ici :
#   firebase functions:secrets:set TYPESENSE_URL        # ex: https://xxx.a1.typesense.net:443
#   firebase functions:secrets:set TYPESENSE_ADMIN_KEY

# Important : Ne commitez JAMAIS votre fichier .env avec des vraies valeurs !
# Le fichier .env est déjà dans .gitignore
