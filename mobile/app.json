{
  "expo": {
    "name": "Rysmo",
    "slug": "rysmo",
    "scheme": "rysmo",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "primaryColor": "#0057BC",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "me.maxmorrys.rysmo",
      "associatedDomains": [
        "applinks:maxmorrys.me",
        "applinks:www.maxmorrys.me",
        "webcredentials:maxmorrys.me"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true,
        "NSFaceIDUsageDescription": "Pour te laisser rouvrir Rysmo sans retaper ton mot de passe. Face ID reste sur ton iPhone : l'application ne le reçoit jamais, et ton mot de passe continue de fonctionner."
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "me.maxmorrys.rysmo",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "maxmorrys.me",
              "pathPrefix": "/formations"
            },
            {
              "scheme": "https",
              "host": "maxmorrys.me",
              "pathPrefix": "/verifier"
            },
            {
              "scheme": "https",
              "host": "www.maxmorrys.me",
              "pathPrefix": "/formations"
            },
            {
              "scheme": "https",
              "host": "www.maxmorrys.me",
              "pathPrefix": "/verifier"
            }
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0B0E13"
          }
        }
      ],
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Fraunces",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Fraunces_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Fraunces_700Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./assets/fonts/Fraunces_900Black.ttf",
                    "weight": 900
                  }
                ]
              },
              {
                "fontFamily": "SchibstedGrotesk",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/SchibstedGrotesk_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/SchibstedGrotesk_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/SchibstedGrotesk_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/SchibstedGrotesk_700Bold.ttf",
                    "weight": 700
                  }
                ]
              },
              {
                "fontFamily": "JetBrainsMono",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/JetBrainsMono_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/JetBrainsMono_700Bold.ttf",
                    "weight": 700
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/Fraunces_400Regular.ttf",
              "./assets/fonts/Fraunces_700Bold.ttf",
              "./assets/fonts/Fraunces_900Black.ttf",
              "./assets/fonts/SchibstedGrotesk_400Regular.ttf",
              "./assets/fonts/SchibstedGrotesk_500Medium.ttf",
              "./assets/fonts/SchibstedGrotesk_600SemiBold.ttf",
              "./assets/fonts/SchibstedGrotesk_700Bold.ttf",
              "./assets/fonts/JetBrainsMono_400Regular.ttf",
              "./assets/fonts/JetBrainsMono_700Bold.ttf"
            ]
          }
        }
      ],
      "expo-local-authentication",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e0d19bd8-2658-4749-b149-0f09173dac30"
      }
    },
    "owner": "my-onoma"
  }
}
