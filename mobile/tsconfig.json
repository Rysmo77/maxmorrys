{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@/*": ["./*"],
      "@tokens": ["../src/design-system/tokens.generated"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../src/design-system/tokens.generated.ts",
    "../src/design-system/icons.ts"
  ]
}
