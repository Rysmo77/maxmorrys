# ══════════════════════════════════════════════════════════════════════════════════
# CE QUE L'APPLICATION NATIVE ATTEND À LA CONSTRUCTION.
#
# Copie ce fichier en `mobile/.env` (ignoré par git) pour développer avec Metro.
# Pour les builds EAS, ces valeurs sont des SECRETS DE PROJET chez Expo — jamais
# dans `eas.json`, jamais dans le dépôt :
#
#     eas secret:create --scope project --name EXPO_PUBLIC_FIREBASE_API_KEY --value …
#
# Les six clés Firebase ne sont pas des secrets au sens strict — le web les embarque
# déjà dans son paquet, et n'importe qui les lit dans un navigateur. Ce qui protège la
# base, ce sont les règles Firestore. On les tient hors du dépôt par hygiène, pas par
# illusion de confidentialité.
#
# ⚠️ Sans elles, l'application se construit mais ne peut rien lire : `config.ts` jette
# en développement, et en production chaque écran affiche une panne nommée.
# ══════════════════════════════════════════════════════════════════════════════════

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=max-morrys.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=max-morrys
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# L'origine des callables. Par défaut `https://api.maxmorrys.me` — à surcharger
# seulement pour pointer un Worker de préproduction.
# EXPO_PUBLIC_API_BASE=

# Le contenu de démonstration. `1` l'allume ; ABSENT en production, et un test
# échoue si le profil `production` d'`eas.json` le porte un jour.
EXPO_PUBLIC_CONTENU_DEMO=1
