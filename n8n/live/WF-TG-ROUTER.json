      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const src=$('TH — Décliner (build)').first().json;\nconst slots=src.slots||[];\nlet g=$input.first().json;\n// Extraction robuste : gere l'objet simplifie {posts:[...]} ET l'enveloppe Gemini brute {candidates:[{content:{parts:[{text}]}}]}\nfunction pickText(x){\n  if(x==null)return null;\n  if(typeof x==='string')return x;\n  if(Array.isArray(x)){for(const e of x){const t=pickText(e);if(t)return t;}return null;}\n  if(typeof x==='object'){\n    if(x.candidates)return pickText(x.candidates);\n    if(x.content)return pickText(x.content);\n    if(x.parts)return pickText(x.parts);\n    if(typeof x.text==='string')return x.text;\n    if(x.output)return pickText(x.output);\n    if(x.message)return pickText(x.message);\n  }\n  return null;\n}\nlet posts=[];\nif(g&&Array.isArray(g.posts))posts=g.posts;\nelse if(g&&Array.isArray(g.Posts))posts=g.Posts;\nelse{\n  let txt=pickText(g);\n  if(typeof txt==='string'){\n    txt=txt.trim().replace(/^```(json)?/i,'').replace(/```$/,'').trim();\n    try{const o=JSON.parse(txt);posts=o.posts||o.Posts||(Array.isArray(o)?o:[]);}catch(e){}\n  }\n}\nif(!Array.isArray(posts))posts=[];\nposts=posts.filter(p=>p&&p.titre&&String(p.titre).trim());\n// Plus de gabarits \"Post N\" : si extraction vide, on echoue -> alerte WF-ERR, aucun post cree\nif(!posts.length)throw new Error('TH décline: extraction Gemini échouée (0 post réel) — thème=\"'+(src.themeTitre||'?')+'\" sortie='+JSON.stringify(g).slice(0,250));\nconst PIL=new Set(['Éducation','Inspiration','Produit','Communauté','Autorité','Autre']);\nconst out=[];\n// ne cree QUE pour les posts reellement generes (pas de padding)\nfor(let i=0;i<slots.length&&i<posts.length;i++){\n  const p=posts[i];\n  const pil=PIL.has(p.pilier)?p.pilier:'Éducation';\n  out.push({json:{Titre:String(p.titre).slice(0,200),Reseau:slots[i].reseau,Format_Post:slots[i].format,Pilier:pil,Thematique:String(src.themeTitre||'').slice(0,100),Date_Publication_Prevue:slots[i].date,Status:'planifié'}});\n}\nreturn out;\n"
      },
