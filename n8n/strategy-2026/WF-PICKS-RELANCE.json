      "parameters": {
        "jsCode": "// Aplatit la sortie NocoDB v3 {id, fields:{}} au format plat de l'ancien nœud Airtable :\n// {...champs, id} — pour que les expressions $('<nom>').json.<Champ> restent valables.\nreturn $input.all().map(i => ({ json: { ...(i.json.fields || {}), id: i.json.id } }));"
