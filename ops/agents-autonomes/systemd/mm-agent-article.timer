[Unit]
Description=Rédaction : deux articles par semaine (décision de Max, 10/11/2026), jeudi et dimanche 08:00 Dakar

[Timer]
OnCalendar=Thu,Sun *-*-* 08:00:00 Africa/Dakar
# Une exécution manquée (VPS éteint) n'est PAS rattrapée : on la lance à la main.
Persistent=false
Unit=mm-agent@article.service

[Install]
WantedBy=timers.target
